{
  "name": "mazare3-jordan",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @mazare3/web --filter @mazare3/api run dev",
    "dev:web": "pnpm --filter @mazare3/web dev",
    "dev:api": "pnpm --filter @mazare3/api dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm run -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @mazare3/db generate",
    "db:generate:safe": "node scripts/db-generate-safe.mjs",
    "db:generate:check": "node scripts/db-generate-safe.mjs --check",
    "db:push": "pnpm --filter @mazare3/db push",
    "db:migrate": "pnpm --filter @mazare3/db migrate",
    "db:seed": "pnpm --filter @mazare3/db seed",
    "db:seed:showcase": "pnpm --filter @mazare3/db seed:showcase",
    "db:cleanup:showcase": "pnpm --filter @mazare3/db cleanup:showcase",
    "db:cleanup:presentation-hygiene": "pnpm --filter @mazare3/db cleanup:presentation-hygiene",
    "db:migrate:showcase-media": "pnpm --filter @mazare3/api exec dotenv -e ../../.env -- tsx scripts/migrate-showcase-media-to-r2.ts",
    "db:studio": "pnpm --filter @mazare3/db studio",
    "postinstall": "pnpm db:generate",
    "test:e2e": "playwright test",
    "test:e2e:seed": "pnpm db:seed && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "qa:api": "node scripts/qa-run-api.mjs",
    "qa:availability": "node scripts/qa-availability-math.mjs && node scripts/qa-availability-api.mjs",
    "qa:search": "node scripts/qa-search-math.mjs && node scripts/qa-search-api.mjs",
    "qa:media": "node scripts/qa-media-api.mjs",
    "qa:property-media": "node scripts/qa-property-public-media.mjs",
    "qa:deposit": "node scripts/qa-deposit-math.mjs && node scripts/qa-deposit-api.mjs",
    "qa:notifications": "node scripts/qa-notifications-api.mjs",
    "qa:email-notifications": "node scripts/qa-email-notifications-api.mjs",
    "qa:owner-approval": "node scripts/qa-run-owner-approval.mjs",
    "qa:settlements": "node scripts/qa-run-settlement.mjs",
    "qa:settlement-cycle": "node scripts/qa-settlement-cycle-api.mjs",
    "qa:reviews": "node scripts/qa-run-reviews.mjs",
    "qa:location-privacy": "node scripts/qa-run-location-privacy.mjs",
    "qa:support": "node scripts/qa-run-support.mjs",
    "qa:background-jobs": "node scripts/qa-run-background-jobs.mjs",
    "jobs:run": "pnpm --filter @mazare3/api exec dotenv -e ../../.env -- tsx scripts/run-background-jobs.ts",
    "qa:rebooking": "node scripts/qa-run-rebooking.mjs",
    "qa:promotions": "node scripts/qa-run-promotions.mjs",
    "qa:coupons": "node scripts/qa-run-coupons.mjs",
    "qa:placements": "node scripts/qa-run-placements.mjs",
    "qa:sponsorship": "node scripts/qa-run-sponsorship.mjs",
    "qa:homepage": "node scripts/qa-run-homepage.mjs",
    "qa:home-personalization": "node scripts/qa-run-home-personalization.mjs",
    "qa:payment-gateway": "node scripts/qa-run-payment-gateway.mjs",
    "qa:paytabs": "node scripts/qa-run-paytabs.mjs",
    "qa:phase1-financial-policy": "pnpm --filter @mazare3/api exec tsx ../../packages/shared/scripts/qa-phase1-financial-policy.ts",
    "env:check": "node scripts/env-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
