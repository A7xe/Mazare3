{
  "name": "mazare3-jordan",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @mazare3/web --filter @mazare3/api run dev",
    "dev:web": "pnpm --filter @mazare3/web dev",
    "dev:api": "pnpm --filter @mazare3/api dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm run -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @mazare3/db generate",
    "db:generate:safe": "node scripts/db-generate-safe.mjs",
    "db:generate:check": "node scripts/db-generate-safe.mjs --check",
    "db:push": "pnpm --filter @mazare3/db push",
    "db:migrate": "pnpm --filter @mazare3/db migrate",
    "db:seed": "pnpm --filter @mazare3/db seed",
    "db:studio": "pnpm --filter @mazare3/db studio",
    "postinstall": "pnpm db:generate",
    "test:e2e": "playwright test",
    "test:e2e:seed": "pnpm db:seed && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "qa:api": "node scripts/qa-run-api.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
