# Mazare3 Jordan — local development
# Copy this file to `.env` at the repository root (single source of truth).
# Do NOT commit `.env`. Never prefix secrets with NEXT_PUBLIC_.

# Used by API/Prisma locally. Next.js sets NODE_ENV itself during dev/build.
NODE_ENV=development

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/mazare3?sslmode=require

# ── API server ─────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Auth (min 32 characters) ───────────────────────────────────────────────
JWT_SECRET=change-me-use-at-least-32-random-characters-here
JWT_EXPIRES_IN=7d
# Optional fallback if JWT_SECRET is unset:
SESSION_SECRET=change-me-use-at-least-32-random-characters-here

LOG_LEVEL=info

# ── Payments (Phase 6B — configuration only, no live calls in dev default) ─
PAYMENT_PROVIDER=test
PAYMENT_MODE=full
PAYMENT_CURRENCY=JOD
PLATFORM_COMMISSION_PERCENT=12
CUSTOMER_SERVICE_FEE_PERCENT=0
OWNER_PAYOUT_DELAY_HOURS=24
CANCELLATION_FREE_UNTIL_HOURS=72
CANCELLATION_PARTIAL_UNTIL_HOURS=24
CANCELLATION_PARTIAL_REFUND_PERCENT=50
LATE_CANCELLATION_REFUND_PERCENT=0
PAYMENT_SIMULATE_ENABLED=false
# CliQ (Phase 6C — leave empty until credentials from bank/provider)
CLIQ_MERCHANT_ALIAS=
CLIQ_API_BASE_URL=
CLIQ_API_KEY=
CLIQ_WEBHOOK_SECRET=
# Card gateway (Phase 6C)
CARD_GATEWAY_PROVIDER=
CARD_GATEWAY_API_BASE_URL=
CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_API_KEY=
CARD_GATEWAY_WEBHOOK_SECRET=

# ── QA / E2E only (never enable in production) ─────────────────────────────
# DISABLE_AUTH_RATE_LIMIT=true
# ENABLE_INTERNAL_QA_ROUTES=true
# PAYMENT_SIMULATE_ENABLED=true
# Use `pnpm qa:api` — starts API on :4012 with QA flags set automatically.

# ── Next.js (public — safe in the browser) ─────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
