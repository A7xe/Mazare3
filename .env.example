# Mazare3 Jordan — environment template
# Copy to repository root:  cp .env.example .env
# Do NOT commit `.env`. Never put secrets in NEXT_PUBLIC_*.
#
# Production checklist (categories only — configure on the host, not by copying secrets here):
#   - production URLs (web + API + CORS)
#   - production database
#   - JWT secret (≥32 random chars)
#   - secure cookies (COOKIE_SECURE=true)
#   - live PayTabs (credentials + HTTPS return/callback + PROFILE_MODE=live)
#   - Resend (EMAIL_PROVIDER=resend + API key + FROM)
#   - public media R2 + private KYC R2 (separate buckets)
#   - partner encryption key
#   - all DEVELOPMENT / QA flags disabled / unset

# =============================================================================
# Core
# =============================================================================
# REQUIRED LOCAL / REQUIRED PRODUCTION
# APP_ENV: local | staging | production  (security & payment guards)
APP_ENV=local
# REQUIRED LOCAL / REQUIRED PRODUCTION
NODE_ENV=development
# OPTIONAL — SAFE DEFAULT 4000
API_PORT=4000

# =============================================================================
# URLs / CORS
# =============================================================================
# REQUIRED LOCAL / REQUIRED PRODUCTION — public API origin (media URL building, server fetches)
API_URL=http://localhost:4000
# REQUIRED LOCAL / REQUIRED PRODUCTION — trusted web origin for password-reset links + CORS fallback
FRONTEND_URL=http://localhost:3000
# REQUIRED LOCAL / REQUIRED PRODUCTION — exact browser origin(s), comma-separated. Never "*" with cookies.
CORS_ORIGIN=http://localhost:3000
# OPTIONAL — PayTabs browser-return redirect fallback (after NEXT_PUBLIC_APP_URL).
# Use the same public web origin as NEXT_PUBLIC_APP_URL when testing via HTTPS tunnel.
# APP_URL=http://localhost:3000
#
# Eventually set FRONTEND_URL, CORS_ORIGIN, NEXT_PUBLIC_APP_URL (and APP_URL if used)
# to the final Mazare3 production domain.

# =============================================================================
# Database
# =============================================================================
# REQUIRED LOCAL / REQUIRED PRODUCTION — PostgreSQL connection string (pooled URL is fine)
# Placeholder only — never commit real credentials
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/mazare3?sslmode=require

# =============================================================================
# Authentication / Session
# =============================================================================
# REQUIRED LOCAL / REQUIRED PRODUCTION — min 32 characters; also used for AUTH-4/5 HMAC
JWT_SECRET=replace-with-production-secret-min-32-chars
# OPTIONAL — used only if JWT_SECRET is unset
SESSION_SECRET=replace-with-production-secret-min-32-chars
# OPTIONAL — SAFE DEFAULT 7d
JWT_EXPIRES_IN=7d
# REQUIRED LOCAL: false | PRODUCTION HTTPS: true | unset = auto for staging/production APP_ENV
COOKIE_SECURE=false
# OPTIONAL — SAFE DEFAULT lax
COOKIE_SAME_SITE=lax
# PRODUCTION ONLY (optional) — e.g. .yourdomain.com when web+API share a parent domain
# COOKIE_DOMAIN=.yourdomain.com

# =============================================================================
# Payment — PayTabs
# =============================================================================
# REQUIRED for live checkout — authoritative selector: mock | paytabs | cliq | card_gateway
# `mock` is local/QA only — forbidden when APP_ENV=production
PAYMENT_GATEWAY_PROVIDER=paytabs
# OPTIONAL — SAFE DEFAULT JOD
PAYMENT_CURRENCY=JOD

# --- Local / test (SAFE DEFAULTS) ---
# DEVELOPMENT: keep PROFILE_MODE=test. Production MUST use live + live credentials + HTTPS URLs.
PAYTABS_PROFILE_MODE=test
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION=JOR
PAYTABS_CURRENCY=JOD
PAYTABS_BASE_URL=https://secure-jordan.paytabs.com
# CB-4 Managed Form (optional). Default hpp keeps Hosted Payment Page path.
# PAYTABS_CHECKOUT_MODE=hpp|managed_form
PAYTABS_CHECKOUT_MODE=hpp
# Browser-side Client Key for Managed Form only — never put Server Key here.
# PAYTABS_CLIENT_KEY=
# CB-5A — persistent card tokenization (vault + save opt-in). Default off.
# Does NOT enable charging saved cards (CB-5B). Requires PayTabs account enablement for live.
PAYTABS_TOKENIZATION_ENABLED=false
# AES-256 key for at-rest vault of PayTabs persistent card tokens (64 hex or 32-byte base64).
# Never put in NEXT_PUBLIC_*. Local QA may omit when ENABLE_INTERNAL_QA_ROUTES=true.
# PAYMENT_VAULT_ENCRYPTION_KEY=
# CB-5B — saved-card charging mode. Default off (safest). Never default to recurring_direct.
# PAYTABS_SAVED_CARD_CHARGE_MODE=off|ecom_cvv_redirect|recurring_direct
PAYTABS_SAVED_CARD_CHARGE_MODE=off
# Required in addition to recurring_direct — merchant/acquirer recurring approval.
PAYTABS_RECURRING_ENABLED=false
# Browser return (informational — not payment truth). Supports {bookingId}/{paymentId}/{locale}.
PAYTABS_RETURN_URL=http://localhost:3000/api/paytabs/browser-return?bookingId={bookingId}&paymentId={paymentId}&locale={locale}
# Server-to-server callback / IPN
PAYTABS_CALLBACK_URL=http://localhost:4000/api/v1/payments/webhooks/paytabs
#
# Production / live (do not enable until go-live):
#   PAYTABS_PROFILE_MODE=live
#   PAYTABS_PROFILE_ID=...
#   PAYTABS_SERVER_KEY=...
#   PAYTABS_RETURN_URL=https://www.your-domain.com/api/paytabs/browser-return?...
#   PAYTABS_CALLBACK_URL=https://api.your-domain.com/api/v1/payments/webhooks/paytabs
# LIVE mode rejects localhost, private IPs, plain HTTP, and ephemeral tunnels.

# =============================================================================
# Public Media — Cloudflare R2
# =============================================================================
# WARNING: Private KYC storage must never use a public bucket URL.
# Prefer PROPERTY_MEDIA_STORAGE_PROVIDER for farm/property photos.
# REQUIRED PRODUCTION for public photos: cloudflare_r2_public
# Local may use local disk via MEDIA_PROVIDER fallback when this is empty.
PROPERTY_MEDIA_STORAGE_PROVIDER=cloudflare_r2_public
MAX_UPLOAD_SIZE_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# Dedicated public-media bucket — never reuse CLOUDFLARE_R2_BUCKET (KYC)
CLOUDFLARE_R2_MEDIA_BUCKET=
# Public delivery base URL / custom domain (no trailing slash; never credentials)
CLOUDFLARE_R2_MEDIA_PUBLIC_URL=
# Dedicated media API token — never NEXT_PUBLIC_*; never reuse KYC token values
CLOUDFLARE_R2_MEDIA_ACCESS_KEY_ID=
CLOUDFLARE_R2_MEDIA_SECRET_ACCESS_KEY=
# Shared account id / region (also used by private KYC R2)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_REGION=auto
# OPTIONAL — leave empty to derive https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_S3_ENDPOINT=

# =============================================================================
# Private Partner / KYC Storage
# =============================================================================
# WARNING: Private KYC storage must never use a public bucket URL.
# REQUIRED PRODUCTION: cloudflare_r2_private
# local_private is APP_ENV=local QA only — forbidden in production
PARTNER_DOCUMENT_STORAGE_PROVIDER=local_private
PARTNER_DOCUMENT_MAX_MB=8
PARTNER_DOCUMENT_MAX_COUNT=24
# Private KYC bucket (S3 API) — never NEXT_PUBLIC_*; never use for public farm photos
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# =============================================================================
# Partner Data Encryption
# =============================================================================
# REQUIRED when partner payout/IBAN encryption is used
# AES-256-GCM: 64 hex chars OR 32-byte standard base64. Server-only. Never NEXT_PUBLIC_*.
# Generate: openssl rand -hex 32
PARTNER_DATA_ENCRYPTION_KEY=

# =============================================================================
# Transactional Email — Resend
# =============================================================================
# LATER — REQUIRED BEFORE PRODUCTION PASSWORD RECOVERY
# Local recommendation: none (no network send). memory = QA capture only (not production).
EMAIL_PROVIDER=none
# Required when EMAIL_PROVIDER=resend
EMAIL_FROM=
# OPTIONAL display name
EMAIL_FROM_NAME=
# OPTIONAL — SAFE DEFAULT 10000 (ms)
# EMAIL_TIMEOUT_MS=10000
# Server-only — never NEXT_PUBLIC_*
RESEND_API_KEY=
#
# Before production password recovery:
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=...
#   EMAIL_FROM=noreply@your-verified-domain.com
#   EMAIL_FROM_NAME=Mazare3 Jordan
#   FRONTEND_URL=https://your-production-origin

# =============================================================================
# Phone OTP (UA-2 / UA-6) — backend ready; public button gated separately
# =============================================================================
# OPTIONAL — SAFE DEFAULT none when unset. Owner does NOT need to set this for local.
# none = no SMS send (PHONE_AUTH_UNAVAILABLE)
# memory = LOCAL/QA ONLY — FORBIDDEN IN PRODUCTION (captures OTP in-process for E2E)
SMS_OTP_PROVIDER=none
# UA-6 — public Phone button on /auth. Default false when unset.
# Requires a real (non-none, non-memory) SMS provider to become available.
PHONE_AUTH_PUBLIC_ENABLED=false
# OPTIONAL TUNING — normally leave unset (code defaults: 5m TTL, 60s resend, 5 attempts)
# PHONE_OTP_TTL_MS=300000
# PHONE_OTP_RESEND_COOLDOWN_MS=60000
# PHONE_OTP_MAX_ATTEMPTS=5

# =============================================================================
# Google OIDC (UA-3 / UA-6) — public Google button when enabled + credentials set
# =============================================================================
# LATER / PUBLIC AUTH ENABLEMENT — owner does NOT need to configure these today.
# Default when unset: Google auth unavailable (safe). No local startup failure.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact callback URI registered in Google Cloud Console, e.g.
#   http://localhost:4000/api/v1/auth/google/callback   (local only)
#   https://api.example.com/api/v1/auth/google/callback (production HTTPS)
GOOGLE_REDIRECT_URI=
# Before public Google login:
#   GOOGLE_AUTH_ENABLED=true
#   GOOGLE_CLIENT_ID=...
#   GOOGLE_CLIENT_SECRET=...   (server-only — never NEXT_PUBLIC_*)
#   GOOGLE_REDIRECT_URI=https://<api-host>/api/v1/auth/google/callback

# =============================================================================
# Availability / Booking
# =============================================================================
# OPTIONAL — SAFE DEFAULT Asia/Amman (Jordan civil time)
PLATFORM_TIME_ZONE=Asia/Amman
# OPTIONAL — SAFE DEFAULT in code if unset
AVAILABILITY_HORIZON_DAYS=90
# OPTIONAL — homepage catalog fetch size; SAFE DEFAULT 150
# HOMEPAGE_CATALOG_LIMIT=150

# =============================================================================
# Owner / Settlement / Fees
# =============================================================================
# OPTIONAL overrides — code has safe defaults; leave as-is unless business policy differs
PLATFORM_COMMISSION_PERCENT=18
PLATFORM_VERIFIED_COMMISSION_PERCENT=15
CUSTOMER_SERVICE_FEE_PERCENT=0
DEFAULT_DEPOSIT_PERCENT=30
FULL_PAYMENT_WITHIN_HOURS=72
BALANCE_DUE_HOURS_BEFORE_START=48
OWNER_PAYOUT_DELAY_HOURS=24
SETTLEMENT_CYCLE_DAYS=21
# OPTIONAL UTC epoch YYYY-MM-DD for settlement windows
# SETTLEMENT_CYCLE_EPOCH=2026-01-01
OWNER_APPROVAL_RESPONSE_MINUTES=60
CANCELLATION_FREE_UNTIL_HOURS=72
CANCELLATION_CHARGE_30_UNTIL_HOURS=48
CANCELLATION_CHARGE_50_UNTIL_HOURS=24

# =============================================================================
# Rate Limiting / Abuse Protection
# =============================================================================
# AUTH-4 (login abuse) + AUTH-5 (distributed IP rate limit) use JWT_SECRET / SESSION_SECRET.
# No extra secrets required. Thresholds have safe code defaults.
#
# OPTIONAL TUNING — normally leave unset
# AUTH_IP_RATE_MAX=30
# AUTH_IP_RATE_WINDOW_MS=900000
# LOGIN_ABUSE_FAIL_THRESHOLD=5
# LOGIN_ABUSE_EXTENDED_THRESHOLD=10
# LOGIN_ABUSE_MAX_THRESHOLD=15
# LOGIN_ABUSE_COOLDOWN_MS=300000
# LOGIN_ABUSE_EXTENDED_COOLDOWN_MS=900000
# LOGIN_ABUSE_MAX_COOLDOWN_MS=1800000
# LOGIN_ABUSE_STATE_TTL_MS=7200000

# =============================================================================
# DEVELOPMENT / QA ONLY — NEVER ENABLE IN PRODUCTION
# =============================================================================
# Leave unset / false for normal local and all production hosts.
# DISABLE_AUTH_RATE_LIMIT=true
# ENABLE_INTERNAL_QA_ROUTES=true
# ENABLE_PASSWORD_RESET_DEV_LINK=true
# DISABLE_LOGIN_ABUSE_PROTECTION=true
# Mock payment capture UI only — DO NOT ENABLE IN PRODUCTION
PAYMENT_SIMULATE_ENABLED=false
# Emergency only: allow LIVE PayTabs profile when APP_ENV is not production
# PAYTABS_ALLOW_LIVE_OUTSIDE_PRODUCTION=true

# =============================================================================
# Frontend Public Variables
# =============================================================================
# Browser-safe only. Never put DB, JWT, R2 secrets, PayTabs server key, Resend, or encryption keys here.
# REQUIRED LOCAL / REQUIRED PRODUCTION — public web origin (also PayTabs return redirect preference)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# REQUIRED LOCAL / REQUIRED PRODUCTION — public API base including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# OPTIONAL map tiles (no API key). Default OpenStreetMap.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=abc
# OPTIONAL public legal / support identity (omit until real values exist — never invent them)
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=
# NEXT_PUBLIC_REGISTRATION_NUMBER=
# NEXT_PUBLIC_TAX_NUMBER=
# NEXT_PUBLIC_REGISTERED_ADDRESS=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=
# NEXT_PUBLIC_SUPPORT_PHONE=

# =============================================================================
# Optional / Alternative Providers
# =============================================================================
# NOT required for the current Mazare3 stack (PayTabs + R2 + Resend path).
# Kept only because runtime code still understands these paths.

# LEGACY — used only when PAYMENT_GATEWAY_PROVIDER is unset. Prefer PAYMENT_GATEWAY_PROVIDER.
# PAYMENT_PROVIDER=test

# Compatibility fallback when PROPERTY_MEDIA_STORAGE_PROVIDER is empty: local | cloudinary | s3
# MEDIA_PROVIDER=local

# Cloudinary — only if MEDIA_PROVIDER / property media = cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# CliQ — only if PAYMENT_GATEWAY_PROVIDER=cliq
# CLIQ_MERCHANT_ALIAS=
# CLIQ_API_BASE_URL=
# CLIQ_API_KEY=
# CLIQ_WEBHOOK_SECRET=

# Generic card gateway — only if PAYMENT_GATEWAY_PROVIDER=card_gateway
# CARD_GATEWAY_PROVIDER=
# CARD_GATEWAY_API_BASE_URL=
# CARD_GATEWAY_MERCHANT_ID=
# CARD_GATEWAY_API_KEY=
# CARD_GATEWAY_WEBHOOK_SECRET=

# Generic private S3 — only if PARTNER_DOCUMENT_STORAGE_PROVIDER=s3_private
# PARTNER_DOCUMENT_S3_ENDPOINT=
# PARTNER_DOCUMENT_S3_REGION=
# PARTNER_DOCUMENT_S3_BUCKET=
# PARTNER_DOCUMENT_S3_ACCESS_KEY_ID=
# PARTNER_DOCUMENT_S3_SECRET_ACCESS_KEY=
# PARTNER_DOCUMENT_S3_FORCE_PATH_STYLE=true

# Email stubs — not live AUTH-3 delivery (use Resend for production)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SENDGRID_API_KEY=
