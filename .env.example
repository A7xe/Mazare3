# Mazare3 Jordan — environment template
# Copy to `.env` at repository root:  cp .env.example .env
# Do NOT commit `.env`. Never put secrets in NEXT_PUBLIC_*.

# ═══════════════════════════════════════════════════════════════════════════
# Application environment
# ═══════════════════════════════════════════════════════════════════════════
# APP_ENV — deployment target (security / payment guards use this)
#   local      — developer machine
#   staging    — hosted trial (test provider + simulate OK)
#   production — live site (real PSP required)
APP_ENV=local

# NODE_ENV — Node/Next build mode (keep development locally; production on hosted build)
NODE_ENV=development

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/mazare3?sslmode=require

# ── API server ─────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Exact frontend origin(s); comma-separated. Never "*" with credentials.
CORS_ORIGIN=http://localhost:3000

# ── Session cookie (API auth) ──────────────────────────────────────────────
# COOKIE_SECURE — true | false | unset (auto: true for staging/production APP_ENV)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com
# Unrelated web/API domains (e.g. vercel.app + railway.app) may need:
# COOKIE_SAME_SITE=none and COOKIE_SECURE=true

# ── Auth (min 32 characters — use random values in real .env) ───────────────
JWT_SECRET=change-me-use-at-least-32-random-characters-here
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-me-use-at-least-32-random-characters-here

LOG_LEVEL=info

# ── Availability (Phase 10B.1) ──────────────────────────────────────────────
# Civil business time zone for schedules and display. Generated instants are stored UTC.
PLATFORM_TIME_ZONE=Asia/Amman
# Rolling generation window in calendar days (operational default, not a commercial rule).
AVAILABILITY_HORIZON_DAYS=90

# ── Payments (Phase 10G.1 gateway boundary — PayTabs in 10G.2A) ─────────────
# Preferred selector. Values: mock | paytabs | cliq | card_gateway
# `mock` (alias `test` via PAYMENT_PROVIDER) is local/QA only — forbidden in APP_ENV=production.
PAYMENT_GATEWAY_PROVIDER=mock
# Legacy alias — used when PAYMENT_GATEWAY_PROVIDER is unset.
PAYMENT_PROVIDER=test
PAYMENT_MODE=full
PAYMENT_CURRENCY=JOD
PLATFORM_COMMISSION_PERCENT=12
CUSTOMER_SERVICE_FEE_PERCENT=0
# Test default only — not a commercial deposit rate.
DEFAULT_DEPOSIT_PERCENT=30
# Hours before booking start when remaining balance is due.
# Timed slots: bookingStartAt − hours. Legacy slots (no startAt): 00:00 UTC of the slot date.
# 0 = due at the real start instant (timed) or at 00:00 UTC of the date (legacy).
BALANCE_DUE_HOURS_BEFORE_START=24
OWNER_PAYOUT_DELAY_HOURS=24
# Days between automatic settlement draft cycles (Phase 10D.2). Independent of payout delay.
SETTLEMENT_CYCLE_DAYS=21
# Optional UTC epoch for cycle windows (YYYY-MM-DD). Default 2026-01-01.
# SETTLEMENT_CYCLE_EPOCH=2026-01-01
# Minutes an owner has to accept/reject a booking request (not used for instant booking).
OWNER_APPROVAL_RESPONSE_MINUTES=60
CANCELLATION_FREE_UNTIL_HOURS=72
CANCELLATION_PARTIAL_UNTIL_HOURS=24
CANCELLATION_PARTIAL_REFUND_PERCENT=50
LATE_CANCELLATION_REFUND_PERCENT=0
# Never enable in APP_ENV=production. Mock capture UI only.
PAYMENT_SIMULATE_ENABLED=false

# ── PayTabs Jordan (Hosted Payment Page) — placeholders only; never commit secrets ──
# Explicit TEST vs LIVE profile. Never inferred from Profile ID or Server Key.
# Local/QA default. Production MUST set PAYTABS_PROFILE_MODE=live.
PAYTABS_PROFILE_MODE=test
# Emergency only: allow LIVE profile when APP_ENV is not production. Do not enable by default.
# PAYTABS_ALLOW_LIVE_OUTSIDE_PRODUCTION=true
# Region endpoint default: https://secure-jordan.paytabs.com
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION=JOR
PAYTABS_CURRENCY=JOD
PAYTABS_BASE_URL=https://secure-jordan.paytabs.com
# Browser return (informational only — never payment truth). Supports {bookingId}/{paymentId}/{locale}.
PAYTABS_RETURN_URL=http://localhost:3000/api/paytabs/browser-return?bookingId={bookingId}&paymentId={paymentId}&locale={locale}
# After PayTabs, /api/paytabs/browser-return redirects using NEXT_PUBLIC_APP_URL (then APP_URL / FRONTEND_URL).
# For a public HTTPS tunnel test, set that origin to the web tunnel, not localhost.
# LIVE mode rejects localhost, private IPs, HTTP, and trycloudflare.com tunnels.
# Server-to-server callback / IPN
PAYTABS_CALLBACK_URL=http://localhost:4000/api/v1/payments/webhooks/paytabs

# CliQ placeholders (do not commit real secrets)
CLIQ_MERCHANT_ALIAS=
CLIQ_API_BASE_URL=
CLIQ_API_KEY=
CLIQ_WEBHOOK_SECRET=
# Card gateway placeholders — other Jordan PSPs (not used when PAYMENT_GATEWAY_PROVIDER=paytabs)
CARD_GATEWAY_PROVIDER=
CARD_GATEWAY_API_BASE_URL=
CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_API_KEY=
CARD_GATEWAY_WEBHOOK_SECRET=

# ── Media uploads (Phase 8A local / Phase 8B Cloudinary optional) ───────
MEDIA_PROVIDER=local
MAX_UPLOAD_SIZE_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# Public farm/property images (Phase 10H.1). Independent of private KYC storage.
# Empty PROPERTY_MEDIA_STORAGE_PROVIDER = fall back to MEDIA_PROVIDER.
# Production public photos: cloudflare_r2_public.
PROPERTY_MEDIA_STORAGE_PROVIDER=
# Dedicated public-media bucket (intended name: mazare3-media). Never reuse CLOUDFLARE_R2_BUCKET.
CLOUDFLARE_R2_MEDIA_BUCKET=
# Public delivery base URL / custom domain (no trailing slash, never a signed URL).
CLOUDFLARE_R2_MEDIA_PUBLIC_URL=
# Dedicated R2 API token for mazare3-media only. Never NEXT_PUBLIC_*. Never reuse KYC token values.
# Precedence: CLOUDFLARE_R2_MEDIA_* keys win when set.
# Fallback (dev only): CLOUDFLARE_R2_ACCESS_KEY_ID + CLOUDFLARE_R2_SECRET_ACCESS_KEY if MEDIA keys are both unset.
CLOUDFLARE_R2_MEDIA_ACCESS_KEY_ID=
CLOUDFLARE_R2_MEDIA_SECRET_ACCESS_KEY=

# ── Partner private data (Phase 10C.1) ─────────────────────────────────────
# AES-256-GCM key: 64 hex chars OR 32-byte standard base64.
# Server-side only. Never NEXT_PUBLIC_*. Generate: openssl rand -hex 32
PARTNER_DATA_ENCRYPTION_KEY=
# Max private verification document size (PDF/JPEG/PNG/WebP).
PARTNER_DOCUMENT_MAX_MB=8
# Max current (non-superseded) documents per partner.
PARTNER_DOCUMENT_MAX_COUNT=24
# local_private is for APP_ENV=local QA only. Production must use cloudflare_r2_private.
PARTNER_DOCUMENT_STORAGE_PROVIDER=local_private
# Optional generic S3-compatible private bucket (not the production default).
PARTNER_DOCUMENT_S3_ENDPOINT=
PARTNER_DOCUMENT_S3_REGION=
PARTNER_DOCUMENT_S3_BUCKET=
PARTNER_DOCUMENT_S3_ACCESS_KEY_ID=
PARTNER_DOCUMENT_S3_SECRET_ACCESS_KEY=
PARTNER_DOCUMENT_S3_FORCE_PATH_STYLE=true
# Cloudflare R2 private KYC bucket (S3 API). Never NEXT_PUBLIC_*.
# Never use this bucket for public farm/property photos (see CLOUDFLARE_R2_MEDIA_BUCKET).
# Endpoint is derived as https://<CLOUDFLARE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional override if you need a custom S3 API URL. Leave empty to derive from account id.
CLOUDFLARE_R2_S3_ENDPOINT=
CLOUDFLARE_R2_REGION=auto

# Cloudinary (Phase 8B — required when MEDIA_PROVIDER=cloudinary; never commit real values)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3 (placeholder — not used unless configured)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (Phase 9A placeholder — not used until delivery is wired) ─────────
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
SENDGRID_API_KEY=

# ── Next.js (public URLs only — safe in browser) ─────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Map tiles (no API key). Local default is OpenStreetMap. Production may replace the URL/style.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=abc
# Optional public operator details (omit until a human supplies real values — never invent them):
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=
# NEXT_PUBLIC_REGISTRATION_NUMBER=
# NEXT_PUBLIC_TAX_NUMBER=
# NEXT_PUBLIC_REGISTERED_ADDRESS=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=
# NEXT_PUBLIC_SUPPORT_PHONE=

# ═══════════════════════════════════════════════════════════════════════════
# Staging (trial — no live payment provider)
# ═══════════════════════════════════════════════════════════════════════════
# NODE_ENV=production          (Next/API build on host)
# APP_ENV=staging
# PAYMENT_PROVIDER=test
# PAYMENT_SIMULATE_ENABLED=true
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax         (same parent domain: staging.* + api.staging.*)
# CORS_ORIGIN=https://staging.yourdomain.com
# FRONTEND_URL=https://staging.yourdomain.com
# API_URL=https://api.staging.yourdomain.com
# Never: DISABLE_AUTH_RATE_LIMIT, ENABLE_INTERNAL_QA_ROUTES

# ═══════════════════════════════════════════════════════════════════════════
# Production (APP_ENV=production)
# ═══════════════════════════════════════════════════════════════════════════
# NODE_ENV=production
# APP_ENV=production
# PAYMENT_PROVIDER=cliq | card_gateway  (all provider env vars set — NOT test)
# PAYMENT_SIMULATE_ENABLED=false
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# See: docs/deployment-checklist.md

# ── QA / E2E only (APP_ENV must not be production) ─────────────────────────
# DISABLE_AUTH_RATE_LIMIT=true
# ENABLE_INTERNAL_QA_ROUTES=true
# PAYMENT_SIMULATE_ENABLED=true
# pnpm qa:api — sets APP_ENV=local on port 4012 automatically
