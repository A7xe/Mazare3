# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
DEFAULT_LOCALE=ar

# Database (Neon PostgreSQL) — required for API + seed
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/mazare3?sslmode=require

# Redis (Phase 3+)
REDIS_URL=redis://localhost:6379

# Auth — Express-owned (HttpOnly cookie + JWT)
AUTH_PROVIDER=express
JWT_SECRET=change-me-use-at-least-32-random-characters-here
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-me-use-at-least-32-random-characters-here

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Next.js web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Uploads (later)
UPLOAD_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (Phase 5 — not used yet)
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info
