{
  "name": "@mazare3/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "dotenv -e ../../.env -- prisma db push",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:legal": "dotenv -e ../../.env -- tsx prisma/seed-legal-bootstrap.ts",
    "seed:legal-launch": "dotenv -e ../../.env -- tsx prisma/seed-legal-launch-candidate.ts",
    "seed:legal-advisor-revised": "dotenv -e ../../.env -- tsx prisma/seed-legal-advisor-revised.ts",
    "seed:legal-owner-advisor-revised": "dotenv -e ../../.env -- tsx prisma/seed-legal-owner-advisor-revised.ts",
    "seed:showcase": "dotenv -e ../../.env -- tsx prisma/seed-showcase-marketplace.ts",
    "cleanup:showcase": "dotenv -e ../../.env -- tsx prisma/cleanup-showcase-marketplace.ts",
    "cleanup:presentation-hygiene": "dotenv -e ../../.env -- tsx prisma/cleanup-showcase-presentation-hygiene.ts",
    "migrate:showcase-media": "dotenv -e ../../.env -- tsx ../../apps/api/scripts/migrate-showcase-media-to-r2.ts",
    "qa:showcase": "dotenv -e ../../.env -- tsx prisma/qa-showcase-marketplace.ts",
    "qa:showcase-media": "dotenv -e ../../.env -- tsx prisma/qa-showcase-property-media.ts",
    "qa:showcase-hygiene": "dotenv -e ../../.env -- tsx prisma/qa-showcase-presentation-hygiene.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate && tsc",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mazare3/shared": "workspace:*",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.19",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  }
}
