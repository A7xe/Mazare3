// Mazare3 Jordan — Phase 2 foundation
// Booking/payment models come in later phases.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

