model OwnerOnboardingChangeRequest {
  id              String    @id @default(cuid())
  ownerProfileId  String
  fieldKey        String
  reason          String    @db.Text
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  owner OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)

  @@index([ownerProfileId, resolved])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorUserId])
  @@index([createdAt])
}

enum DeliveryChannel {
  email
}

enum DeliveryStatus {
  skipped
  queued
  sent
  failed
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  roleTarget UserRole?
  type       String
  title      String
  message    String    @db.Text
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isRead, createdAt])
  @@index([roleTarget, isRead, createdAt])
  @@index([type, entityId, userId])
}

model NotificationDelivery {
  id               String          @id @default(cuid())
  notificationId   String?
  userId           String?
  channel          DeliveryChannel @default(email)
  provider         String
  recipientMasked  String
  status           DeliveryStatus
  errorMessage     String?         @db.Text
  createdAt        DateTime        @default(now())
  sentAt           DateTime?

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([notificationId])
}

/// Phase 2 — operational incidents (no-show, access, force majeure).
model BookingIncident {
  id              String               @id @default(cuid())
  bookingId       String
  type            BookingIncidentType
  status          BookingIncidentStatus @default(open)
  openedByUserId  String
  reason          String?              @db.Text
  evidenceText    String?              @db.Text
  adminNote       String?              @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  /// Explicit Customer election — never set from Owner/Admin actors.
  customerResolutionChoice         ForceMajeureCustomerChoice?
  customerResolutionChosenAt       DateTime?
  customerResolutionChosenByUserId String?
  customerResolutionSource         String?
  customerChosenTargetSlotId       String?
  customerResolutionInvalidatedAt  DateTime?

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy User    @relation("BookingIncidentOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)
  customerResolutionChosenBy User? @relation("BookingIncidentFmChoiceBy", fields: [customerResolutionChosenByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, status])
  @@index([type, status])
  @@index([customerResolutionChosenByUserId])
}

/// Phase 2 — owner reliability tracking (not public scoring).
model OwnerReliabilityIncident {
  id             String                   @id @default(cuid())
  ownerProfileId String
  bookingId      String?
  category       OwnerReliabilityCategory
  reason         String                   @db.Text
  penaltyAmount  Decimal?                 @db.Decimal(10, 2)
  waived         Boolean                  @default(false)
  waivedReason   String?                  @db.Text
  waivedAt       DateTime?
  waivedByUserId String?
  adminNote      String?                  @db.Text
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  owner OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)

  @@index([ownerProfileId, category])
  @@index([bookingId])
}

/// Phase 2 — owner penalty liabilities deducted from future settlements.
model OwnerFinancialAdjustment {
  id             String                       @id @default(cuid())
  ownerProfileId String
  bookingId      String
  settlementId   String?
  type           OwnerFinancialAdjustmentType
  status         OwnerFinancialAdjustmentStatus @default(pending)
  amount         Decimal                      @db.Decimal(10, 2)
  currency       String                       @default("JOD")
  reason         String                       @db.Text
  adminNote      String?                      @db.Text
  appliedAt      DateTime?
  waivedAt       DateTime?
  waivedByUserId String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  owner      OwnerProfile     @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  settlement OwnerSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([ownerProfileId, status])
  @@index([bookingId])
  @@index([settlementId])
}

/// Phase 2/3A — reschedule request/accept workflow with pricing snapshots.
model BookingRescheduleRequest {
  id                  String                       @id @default(cuid())
  bookingId           String
  requestedBy         BookingRescheduleRequestedBy
  requestedByUserId   String
  status              BookingRescheduleRequestStatus @default(pending)
  fromSlotId          String
  toSlotId            String
  fromMerchantValue   Decimal                      @db.Decimal(10, 2)
  toMerchantValue     Decimal                      @db.Decimal(10, 2)
  priceDelta          Decimal                      @db.Decimal(10, 2)
  /// What the customer pays commercially for the booking after finalize.
  customerContractedValue Decimal                  @db.Decimal(10, 2)
  /// What the customer must pay NOW to finalize (0 if owner absorbs; negative = refund).
  customerPayableDelta    Decimal                  @default(0) @db.Decimal(10, 2)
  /// Commission basis after finalize.
  commissionBasisValue    Decimal                  @db.Decimal(10, 2)
  /// Nominal target slot list price (audit).
  listToMerchantValue     Decimal?                 @db.Decimal(10, 2)
  ownerAbsorbsAmount      Decimal                  @default(0) @db.Decimal(10, 2)
  /// customer_market | owner_price_freeze | force_majeure_equivalent | force_majeure_upgrade
  pricingMode             String
  deltaPaymentId          String?                  @unique
  targetSlotHeldUntil     DateTime?
  completedAt             DateTime?
  exemptFromRescheduleLimit Boolean                @default(false)
  exemptFromCancelAnchor    Boolean                @default(false)
  respondedAt         DateTime?
  expiresAt           DateTime?
  adminNote           String?                      @db.Text
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  booking          Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedByUser  User    @relation("RescheduleRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@index([requestedByUserId])
  @@index([status, expiresAt])
  @@index([status, targetSlotHeldUntil])
}

/// Phase 2 — optional Mazare3-funded goodwill credit (separate from refund).
model Mazare3GoodwillCredit {
  id               String                    @id @default(cuid())
  customerId       String
  bookingId        String?
  amount           Decimal                   @db.Decimal(10, 2)
  currency         String                    @default("JOD")
  reason           String                    @db.Text
  status           Mazare3GoodwillCreditStatus @default(pending)
  createdByAdminId String?
  issuedAt         DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  customer       User     @relation("GoodwillCreditCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdByAdmin User?    @relation("GoodwillCreditAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([bookingId])
}

// ─── Phase 3B — Legal / consent architecture ─────────────────────────────────

enum LegalDocumentType {
  terms_and_conditions
  privacy_policy
  cancellation_refund_policy
  owner_agreement
  booking_terms
  cookie_policy
  verification_policy
  community_review_policy
}

enum LegalDocumentStatus {
  draft
  scheduled
  active
  superseded
  archived
}

enum LegalAcceptanceContext {
  registration
  login_reacceptance
  checkout
  owner_onboarding
  owner_agreement_update
  policy_update
  privacy_consent
  marketing_consent
  commercial_terms_ack
}

enum LegalAcceptanceEvidenceSource {
  user_explicit_acceptance
  system_import_admin_exception
}

enum PrivacyConsentPurpose {
  marketing_email
  marketing_sms
  personalized_analytics
  optional_cookies
}

enum PrivacyConsentStatus {
  granted
  withdrawn
}

/// Phase 3C.4B.1.4 — Jordan PDPL Prior Consent (service purposes). Distinct from optional PrivacyConsent.
enum DataProcessingConsentPurpose {
  account_registration_and_authentication
  marketplace_booking_processing
  payment_and_refund_processing
  saved_payment_method_processing
  support_and_dispute_processing
  owner_account_and_marketplace_operation
  owner_identity_and_authority_verification
  property_and_exact_location_processing
  owner_payout_and_financial_processing
}

enum DataProcessingConsentStatus {
  granted
  withdrawn
  superseded
  expired
}

enum DataSubjectRequestType {
  access
  correction
  erasure
  objection
  portability
  privacy_inquiry
  /// Phase 3C.4B.1.1 — distinct privacy complaint (not auto-inquiry)
  privacy_complaint
  /// Phase 3C.4B.1 — Jordan rights coverage
  restriction
  consent_withdrawal
}

enum DataSubjectRequestStatus {
  requested
  under_review
  fulfilled
  partially_fulfilled
  rejected_with_reason
}

/// Phase 3C.2 — counsel review gate (Production activation must require approved later).
enum LegalReviewStatus {
  not_reviewed
  under_review
  approved
  approved_with_changes
  rejected
}

/// Phase 3C.2 — internal founder/business publication approval (not counsel approval).
enum FounderApprovalStatus {
  pending
  approved
  rejected
}

/// Logical bilingual release (AR/EN share legalReleaseId; each language has its own content hash).
model LegalRelease {
  id                   String              @id @default(cuid())
  documentType         LegalDocumentType
  version              String
  status               LegalDocumentStatus @default(draft)
  requiresReacceptance Boolean             @default(false)
  materialChange       Boolean             @default(false)
  changelog            String?             @db.Text
  summaryOfChanges     String?             @db.Text
  effectiveAt          DateTime?
  publishedAt          DateTime?
  supersededAt         DateTime?
  createdAt            DateTime            @default(now())
  createdByUserId      String?

  /// Phase 3C.2 governance — counsel review (do not invent reviewer identity).
  legalReviewStatus    LegalReviewStatus     @default(not_reviewed)
  legalReviewedAt      DateTime?
  legalReviewReference String?
  legalReviewNote      String?               @db.Text
  /// Phase 3C.2 — founder/business approval separate from counsel.
  founderApprovalStatus FounderApprovalStatus @default(pending)
  founderApprovedAt     DateTime?
  founderApprovalNote   String?

  versions    LegalDocumentVersion[]
  acceptances LegalAcceptance[]

  @@unique([documentType, version])
  @@index([documentType, status])
}

/// Per-language publication of a LegalRelease. Immutable once active/superseded.
model LegalDocumentVersion {
  id              String              @id @default(cuid())
  releaseId       String
  documentType    LegalDocumentType
  version         String
  /// ar | en
  language        String
  title           String
  content         String              @db.Text
  contentHash     String
  status          LegalDocumentStatus @default(draft)
  publishedAt     DateTime?
  effectiveAt     DateTime?
  supersededAt    DateTime?
  createdAt       DateTime            @default(now())
  createdByUserId String?
  /// e.g. static file path used for bootstrap import
  sourceRef       String?

  release     LegalRelease       @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  acceptances LegalAcceptance[]
  privacyConsents PrivacyConsent[]

  bookingSnapshotsAsTerms            BookingLegalSnapshot[] @relation("SnapshotTermsVersion")
  bookingSnapshotsAsCancellation     BookingLegalSnapshot[] @relation("SnapshotCancellationVersion")
  bookingSnapshotsAsBookingTerms     BookingLegalSnapshot[] @relation("SnapshotBookingTermsVersion")
  bookingSnapshotsAsPrivacyNotice    BookingLegalSnapshot[] @relation("SnapshotPrivacyNoticeVersion")

  @@unique([releaseId, language])
  @@index([documentType, language, status])
  @@index([contentHash])
}

/// Immutable evidence of explicit acceptance. Core fields are never updated after create.
model LegalAcceptance {
  id                   String                        @id @default(cuid())
  userId               String
  documentVersionId    String
  releaseId            String
  documentType         LegalDocumentType
  documentVersion      String
  documentHash         String
  language             String
  acceptedAt           DateTime                      @default(now())
  acceptanceContext    LegalAcceptanceContext
  relatedBookingId     String?
  relatedOwnerProfileId String?
  sourceSurface        String?
  explicitAction       Boolean                       @default(true)
  evidenceSource       LegalAcceptanceEvidenceSource @default(user_explicit_acceptance)
  withdrawnAt          DateTime?
  /// Conservative metadata — prefer omit raw IP; optional ipHash only when documented.
  metadata             Json?

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocumentVersion LegalDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  release              LegalRelease         @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  booking              Booking?             @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)
  ownerProfile         OwnerProfile?        @relation(fields: [relatedOwnerProfileId], references: [id], onDelete: SetNull)

  @@index([userId, documentType])
  @@index([relatedBookingId])
  @@index([documentVersionId])
  @@index([releaseId])
  @@index([relatedOwnerProfileId])
}

/// Governing legal + financial SSOT snapshot captured at booking creation (not fabricated later).
model BookingLegalSnapshot {
  id                         String   @id @default(cuid())
  bookingId                  String   @unique
  financialPolicyKey         String
  financialPolicyHash        String
  termsVersionId             String?
  cancellationPolicyVersionId String?
  bookingTermsVersionId      String?
  privacyNoticeVersionId     String?
  commissionPercent          Decimal  @db.Decimal(5, 2)
  depositPercent             Decimal  @db.Decimal(5, 2)
  cancellationRulesJson      Json
  balanceDueHoursBeforeStart Int
  fullPaymentWithinHours     Int
  createdAt                  DateTime @default(now())

  booking                   Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  termsVersion              LegalDocumentVersion? @relation("SnapshotTermsVersion", fields: [termsVersionId], references: [id], onDelete: SetNull)
  cancellationPolicyVersion LegalDocumentVersion? @relation("SnapshotCancellationVersion", fields: [cancellationPolicyVersionId], references: [id], onDelete: SetNull)
  bookingTermsVersion       LegalDocumentVersion? @relation("SnapshotBookingTermsVersion", fields: [bookingTermsVersionId], references: [id], onDelete: SetNull)
  privacyNoticeVersion      LegalDocumentVersion? @relation("SnapshotPrivacyNoticeVersion", fields: [privacyNoticeVersionId], references: [id], onDelete: SetNull)

  @@index([financialPolicyKey])
}

/// Phase 3C.4D.6 — immutable Booking-time listing snapshot (INITIAL evidence)
enum BookingPropertySnapshotKind {
  initial
}

model BookingPropertySnapshot {
  id                        String                      @id @default(cuid())
  bookingId                 String
  kind                      BookingPropertySnapshotKind  @default(initial)
  /// Canonical schema id — do not reinterpret old payloads under a new version
  schemaVersion             String
  propertyId                String
  /// Property.updatedAt when snapshot was taken (source version reference)
  propertyUpdatedAt         DateTime?
  /// Canonical structured payload (Customer-safe facts + internal gate refs)
  payload                   Json
  /// SHA-256 hex of canonical JSON — integrity aid, not a digital signature
  integrityHash             String?
  createdAt                 DateTime                    @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, kind])
  @@index([propertyId])
  @@index([createdAt])
}

/// Purpose-specific optional privacy consents (never bundled with Terms). History preserved via withdrawnAt.
model PrivacyConsent {
  id              String                @id @default(cuid())
  userId          String
  purposeCode     PrivacyConsentPurpose
  consentVersion  String
  noticeVersionId String?
  status          PrivacyConsentStatus  @default(granted)
  grantedAt       DateTime              @default(now())
  withdrawnAt     DateTime?
  sourceSurface   String?
  metadata        Json?

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  noticeVersion LegalDocumentVersion? @relation(fields: [noticeVersionId], references: [id], onDelete: SetNull)

  @@index([userId, purposeCode, status])
  @@index([noticeVersionId])
}

/// Phase 3C.4B.1.4 — Jordan Prior Consent evidence (Arts 4–5). Append-safe history; never admin-fabricated.
/// Distinct from PrivacyConsent (optional marketing/analytics/cookies) and LegalAcceptance (Terms/Privacy notice).
model DataProcessingConsent {
  id                 String                        @id @default(cuid())
  userId             String
  purposeKey         DataProcessingConsentPurpose
  /// Corpus / purpose-definition version (e.g. 3c4b1-4-prior-consent-v1).
  purposeVersion     String
  language           String
  /// Exact consent text shown to the Data Subject.
  consentText        String                        @db.Text
  /// SHA-256 hex of corpusVersion + purposeKey + language + consentText.
  consentTextHash    String
  status             DataProcessingConsentStatus   @default(granted)
  grantedAt          DateTime                      @default(now())
  withdrawnAt        DateTime?
  supersededAt       DateTime?
  expiresAt          DateTime?
  /// Always DURATION_REQUIRES_LEGAL_REVIEW until counsel defines duration.
  durationStatus     String                        @default("DURATION_REQUIRES_LEGAL_REVIEW")
  /// Optional event-based validity label (undefined until counsel defines).
  validityEvent      String?
  sourceSurface      String?
  relatedEntityType  String?
  relatedEntityId    String?
  privacyNoticeVersionId String?
  metadata           Json?
  createdAt          DateTime                      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purposeKey, status])
  @@index([purposeKey, status])
  @@index([consentTextHash])
  @@index([grantedAt])
}

/// Owner acknowledgement of commercial terms (no auto-backfill of historical accepts).
model CommercialTermsAcceptance {
  id                String                        @id @default(cuid())
  ownerProfileId    String
  commercialTermsId String
  acceptedAt        DateTime                      @default(now())
  acceptedByUserId  String
  evidenceSource    LegalAcceptanceEvidenceSource @default(user_explicit_acceptance)
  documentHash      String?
  adminIssuerUserId String?
  metadata          Json?

  ownerProfile    OwnerProfile           @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  commercialTerms PartnerCommercialTerms @relation(fields: [commercialTermsId], references: [id], onDelete: Restrict)
  acceptedBy      User                   @relation("CommercialTermsAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Cascade)

  @@unique([ownerProfileId, commercialTermsId])
  @@index([acceptedByUserId])
  @@index([commercialTermsId])
}

model DataSubjectRequest {
  id               String                    @id @default(cuid())
  userId           String?
  email            String?
  type             DataSubjectRequestType
  status           DataSubjectRequestStatus  @default(requested)
  description      String?                   @db.Text
  adminNote        String?                   @db.Text
  rejectionReason  String?                   @db.Text
  /// Phase 3C.4B.1 — receipt instant (defaults to create time).
  receivedAt       DateTime                  @default(now())
  /// Phase 3C.4B.1 — 15 working days from the day after receipt (Asia/Amman).
  dueAt            DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  resolvedAt       DateTime?
  handledByUserId  String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([email])
  @@index([status, createdAt])
  @@index([status, dueAt])
}

/// Phase 3C.4B.1.2 — personal-data breach readiness (NOT BookingIncident).
enum PersonalDataBreachIncidentKind {
  security_incident_only
  personal_data_breach
}

enum PersonalDataBreachWorkflowStatus {
  reported
  triage
  investigating
  contained
  legal_assessment
  notification_required
  notification_in_progress
  monitoring
  closed
}

enum SevereHarmAssessmentStatus {
  unassessed
  assessing
  severe_harm_likely
  severe_harm_not_likely
  legal_review_required
}

enum LegalNotificationAssessment {
  not_assessed
  not_notifiable
  notifiable_pending_confirmation
  notifiable_confirmed
  legal_review_required
}

enum BreachNotificationChannelStatus {
  not_required
  pending_review
  required
  prepared
  approved_for_send
  attempted
  partially_sent
  sent
  confirmed
  failed
  manual_followup_required
  overdue
}

/// Per Affected Data Subject / recipient notice evidence (3C.4B.1.3).
enum BreachRecipientNoticeState {
  not_required
  pending
  prepared
  approved
  attempted
  sent
  delivery_confirmed
  failed
  manual_followup_required
}

/// Phase 3C.4B.1.3 — least-privilege admin capabilities (not a full IAM redesign).
enum AdminCapability {
  privacy_breach_view
  privacy_breach_manage
  privacy_breach_notification_approve
  privacy_breach_authority_record
  privacy_breach_discovery_correct_later
}

model UserCapabilityGrant {
  id              String          @id @default(cuid())
  userId          String
  capability      AdminCapability
  grantedByUserId String?
  createdAt       DateTime        @default(now())

  user      User  @relation("CapabilityGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("CapabilityGrantIssuer", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, capability])
  @@index([capability])
}

/// Jordan PDPL Art. 20 readiness — dedicated privacy/security domain.
/// Do not store copies of breached payloads, KYC bytes, PAN/CVV, or secrets.
model PersonalDataBreachIncident {
  id        String @id @default(cuid())
  title     String
  internalSummary String? @db.Text

  incidentKind   PersonalDataBreachIncidentKind
  workflowStatus PersonalDataBreachWorkflowStatus @default(reported)

  /// Authoritative discovery instant for Article 20 clocks (never silently overwritten).
  discoveredAt DateTime
  /// Snapshot of originally recorded discovery (immutable after create).
  initiallyRecordedDiscoveryAt DateTime
  /// Optional human-authorised correction; does not erase discoveredAt / initial record.
  correctedDiscoveryAt DateTime?
  discoveryCorrectionReason String? @db.Text
  discoveryCorrectionReviewedByUserId String?
  discoveryCorrectionReviewedAt DateTime?

  occurredAt  DateTime?
  containedAt DateTime?
  closedAt    DateTime?

  discoverySource String?
  affectedSystems Json?
  affectedDataCategories Json?
  affectedDataSubjectCategories Json?
  estimatedAffectedCount Int?
  /// ID/group references only — minimise PII in this JSON. Detail view only.
  affectedSubjectRefs Json?

  involvesSensitivePersonalData  Boolean @default(false)
  involvesFinancialSensitiveData Boolean @default(false)
  involvesKycData                Boolean @default(false)
  involvesCredentialsAuthData    Boolean @default(false)
  dataWasEncrypted               Boolean?
  encryptionKeysCompromised      Boolean?

  sourceMechanismDescription String? @db.Text
  containmentActions         String? @db.Text
  remediationActions         String? @db.Text
  containmentChecklist       Json?
  likelyConsequences         String? @db.Text

  severeHarmAssessment SevereHarmAssessmentStatus @default(unassessed)
  severeHarmReason     String? @db.Text
  severeHarmFactorKeys Json?
  /// Append-only prior assessments (reopen must not erase).
  assessmentHistory    Json?

  legalNotificationAssessment LegalNotificationAssessment @default(not_assessed)

  reviewedByUserId String?
  reviewedAt       DateTime?

  /// Art. 20 affected Data Subject notice (Customers are only one subset).
  dataSubjectNotificationRequired Boolean @default(false)
  authorityNotificationRequired Boolean @default(false)
  dataSubjectNotificationDueAt    DateTime?
  authorityNotificationDueAt   DateTime?
  dataSubjectNotificationStatus   BreachNotificationChannelStatus @default(not_required)
  authorityNotificationStatus   BreachNotificationChannelStatus @default(not_required)

  dataSubjectNoticeDraftJson   Json?
  dataSubjectNoticeContentHash String?
  dataSubjectNoticeApprovedAt  DateTime?
  /// Aggregate only — prefer per-recipient PersonalDataBreachRecipientNotice evidence.
  dataSubjectNoticeSentAt      DateTime?

  authorityPackJson          Json?
  authorityPackApprovedAt     DateTime?
  authoritySubmittedAt        DateTime?
  authoritySubmissionReference String?
  authoritySubmittedByUserId   String?

  internalNotes String? @db.Text

  reportedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reportedBy User? @relation("BreachReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("BreachReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  recipientNotices PersonalDataBreachRecipientNotice[]
  deadlineHistory  PersonalDataBreachDeadlineHistory[]

  @@index([workflowStatus, discoveredAt])
  @@index([incidentKind, severeHarmAssessment])
  @@index([dataSubjectNotificationDueAt])
  @@index([authorityNotificationDueAt])
  @@index([createdAt])
}

model PersonalDataBreachRecipientNotice {
  id               String @id @default(cuid())
  breachIncidentId String

  subjectCategory BreachDataSubjectCategoryLabel
  /// Prefer existing account refs — do not copy bulk PII.
  userId          String?
  ownerProfileId  String?
  /// Minimal external ref when no Mazare3 account (label/token only — minimise contact data).
  externalRef     String?
  contactChannel  String  @default("email")

  contentHash String?
  state       BreachRecipientNoticeState @default(pending)

  preparedAt  DateTime?
  approvedAt  DateTime?
  attemptedAt DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  failureCategory String?
  fallbackManualStatus String?
  deliveryState String?

  actorUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incident PersonalDataBreachIncident @relation(fields: [breachIncidentId], references: [id], onDelete: Cascade)
  actor    User? @relation("BreachRecipientNoticeActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([breachIncidentId, state])
  @@index([userId])
}

enum BreachDataSubjectCategoryLabel {
  customer
  owner_partner
  visitor_unauthenticated
  admin_staff
  mixed
  unknown_or_non_account
}

model PersonalDataBreachDeadlineHistory {
  id               String   @id @default(cuid())
  breachIncidentId String
  kind             String
  discoveryAt      DateTime
  dataSubjectDueAt DateTime?
  authorityDueAt   DateTime?
  reason           String?  @db.Text
  reviewerUserId   String?
  recordedAt       DateTime @default(now())
  /// Snapshot of prior values before this change (JSON).
  previousSnapshot Json?

  incident PersonalDataBreachIncident @relation(fields: [breachIncidentId], references: [id], onDelete: Cascade)
  reviewer User? @relation("BreachDeadlineHistoryReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([breachIncidentId, recordedAt])
}

/// Phase 3C.4B.2C — Article 14 transfer/exchange register (compliance evidence).
/// Does NOT store copied raw Personal Data. Legal sufficiency: COUNSEL_REVIEW_REQUIRED.
enum PersonalDataTransferBorderScope {
  domestic
  cross_border
  unknown_pending_review
}

enum PersonalDataTransferRegisterReviewStatus {
  draft
  recorded
  under_counsel_review
  closed
}

model PersonalDataTransferRegisterEntry {
  id                        String   @id @default(cuid())
  /// Processing activity key from privacy inventory / Prior Consent purpose where applicable.
  processingActivityKey     String
  /// Category codes only — never paste raw Personal Data payloads.
  dataCategoryCodes         String[]
  recipientKey              String
  recipientVerifiedLabel    String?
  purpose                   String   @db.Text
  borderScope               PersonalDataTransferBorderScope @default(unknown_pending_review)
  consentPurposeKey         String?
  consentPurposeVersion     String?
  privacyNoticeVersionId    String?
  dataProcessingConsentId   String?
  startedAt                 DateTime @default(now())
  effectiveAt               DateTime?
  endedAt                   DateTime?
  /// Only when a statutory exception is counsel-confirmed; otherwise null.
  legalExceptionReference   String?
  reviewStatus              PersonalDataTransferRegisterReviewStatus @default(draft)
  legalSufficiencyStatus    String   @default("COUNSEL_REVIEW_REQUIRED")
  notes                     String?  @db.Text
  createdByUserId           String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([processingActivityKey, reviewStatus])
  @@index([recipientKey])
  @@index([borderScope, reviewStatus])
  @@index([dataProcessingConsentId])
  @@index([startedAt])
}
