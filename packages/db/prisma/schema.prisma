model User {
  id               String     @id @default(cuid())
  name             String?
  /** Nullable for future phone-first accounts. Unique when non-null (Postgres). */
  email            String?    @unique
  phone            String?
  passwordHash     String?
  /** Set when password is created/changed; used to invalidate older JWT sessions. */
  passwordChangedAt DateTime?
  /** Legacy unused stub — do not use for Unified Auth. Prefer AuthIdentity. */
  externalAuthId   String?
  /** Legacy unused stub — do not use for Unified Auth. Prefer AuthIdentity. */
  externalProvider String?
  role             UserRole   @default(customer)
  status           UserStatus @default(active)
  locale           String     @default("ar")
  /// Phase 3C.4B.1.3 — elevated admin (grants all privacy_breach_* capabilities).
  superAdmin       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  ownerProfile OwnerProfile?
  favorites    Favorite[]
  bookings       Booking[]
  payments       Payment[]
  refundRequests RefundRequest[]
  disputesOpened Dispute[]       @relation("DisputeOpenedBy")
  supportTickets SupportTicket[]
  reviews        Review[]
  couponRedemptions CouponRedemption[]
  platformCouponRedemptions PlatformCouponRedemption[]
  placementsCreated PropertyPlacement[]
  auditLogs      AuditLog[]      @relation("AuditActor")
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  passwordResetTokens    PasswordResetToken[]
  authIdentities         AuthIdentity[]
  savedPaymentMethods    SavedPaymentMethod[]
  bookingIncidentsOpened BookingIncident[] @relation("BookingIncidentOpenedBy")
  bookingIncidentFmChoices BookingIncident[] @relation("BookingIncidentFmChoiceBy")
  rescheduleRequestsMade BookingRescheduleRequest[] @relation("RescheduleRequestedBy")
  goodwillCreditsIssued    Mazare3GoodwillCredit[] @relation("GoodwillCreditAdmin")
  goodwillCreditsReceived  Mazare3GoodwillCredit[] @relation("GoodwillCreditCustomer")
  legalAcceptances         LegalAcceptance[]
  privacyConsents          PrivacyConsent[]
  dataProcessingConsents   DataProcessingConsent[]
  personalDataTransferRegisterEntries PersonalDataTransferRegisterEntry[]
  dataSubjectRequests      DataSubjectRequest[]
  commercialTermsAcceptances CommercialTermsAcceptance[] @relation("CommercialTermsAcceptedBy")
  personalDataBreachesReported PersonalDataBreachIncident[] @relation("BreachReportedBy")
  personalDataBreachesReviewed PersonalDataBreachIncident[] @relation("BreachReviewedBy")
  capabilityGrants             UserCapabilityGrant[] @relation("CapabilityGrantUser")
  capabilityGrantsIssued       UserCapabilityGrant[] @relation("CapabilityGrantIssuer")
  breachRecipientNoticesActed  PersonalDataBreachRecipientNotice[] @relation("BreachRecipientNoticeActor")
  breachDeadlineHistoriesReviewed PersonalDataBreachDeadlineHistory[] @relation("BreachDeadlineHistoryReviewer")
  // LoginAbuseState is keyed by HMAC(email), not userId — no User relation.

  @@index([role])
  @@index([status])
}

/**
 * UA-1 — one User may have many authentication identities.
 * providerSubject is the canonical provider key (normalized email / E.164 / Google sub).
 * verifiedAt: null for legacy password identities (no email-verification product yet);
 * set when phone OTP or Google OIDC successfully proves the identity (UA-2+).
 */
model AuthIdentity {
  id              String               @id @default(cuid())
  userId          String
  provider        AuthIdentityProvider
  providerSubject String
  verifiedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

/**
 * UA-1 foundation only — no OTP send/verify yet (UA-2).
 * identifierHash = privacy-preserving digest of canonical phone (HMAC in UA-2).
 * codeHash stores hashed OTP only — never plaintext code.
 */
model OtpChallenge {
  id             String              @id @default(cuid())
  identifierHash String
  codeHash       String
  purpose        OtpChallengePurpose
  attempts       Int                 @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([identifierHash, purpose])
  @@index([expiresAt])
}

/** Single-use password recovery tokens. Raw token is never stored — only tokenHash. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * AUTH-4 — identifier-aware login abuse state.
 * identifierKey = HMAC-SHA256(serverSecret, normalizedEmail). Raw email is never stored.
 * Temporary cooldowns only — never permanent lockout.
 */
model LoginAbuseState {
  identifierKey   String    @id
  failCount       Int       @default(0)
  windowStartedAt DateTime  @default(now())
  cooldownUntil   DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
  @@index([cooldownUntil])
}

/**
 * AUTH-5 — shared IP (and similar) rate-limit buckets for multi-instance APIs.
 * keyHash = HMAC of canonical client identity. Raw IP is never stored.
 */
model RateLimitBucket {
  id        String   @id @default(cuid())
  namespace String
  keyHash   String
  hits      Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, keyHash])
  @@index([resetAt])
}

model OwnerProfile {
  id                   String      @id @default(cuid())
  userId               String      @unique
  displayName          String
  businessName         String?
  phone                String // never exposed on public listing UI
  city                 String?
  area                 String?
  bio                  String?     @db.Text
  approximateFarmCount Int?
  termsAcceptedAt      DateTime?
  status               OwnerStatus @default(pending)
  rejectionReason      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
  payouts    OwnerPayout[]
  settlements OwnerSettlement[]
  verificationProfile  OwnerVerificationProfile?
  documents            OwnerDocument[]
  payoutProfile        OwnerPayoutProfile?
  agreementAcceptances PartnerAgreementAcceptance[]
  commercialTerms      PartnerCommercialTerms[]
  commercialTermsAcceptances CommercialTermsAcceptance[]
  changeRequests       OwnerOnboardingChangeRequest[]
  sponsorshipOrders    SponsoredPlacementOrder[]
  reliabilityIncidents OwnerReliabilityIncident[]
  financialAdjustments OwnerFinancialAdjustment[]
  legalAcceptances     LegalAcceptance[]
  operatorParties      OperatorParty[]
  ownerAttestations    OwnerAttestation[]
}

model Property {
  id                    String             @id @default(cuid())
  ownerId               String
  slug                  String             @unique
  type                  PropertyType
  titleAr               String
  titleEn               String?
  descriptionAr         String             @db.Text
  descriptionEn         String?            @db.Text
  /// Nullable so truthful incomplete drafts can omit location until Step 2.
  city                  String?
  /// Nullable so truthful incomplete drafts can omit location until Step 2.
  area                  String?
  /// Nullable so truthful incomplete drafts can omit location until Step 2.
  approximateAddress    String?
  exactAddress          String? // hidden from public API/UI until booking confirmed
  latitudeApprox        Float?
  longitudeApprox       Float?
  latitudeExact         Float?
  longitudeExact        Float?
  arrivalInstructionsAr String? @db.Text
  arrivalInstructionsEn String? @db.Text
  capacity              Int
  bedrooms              Int                @default(0)
  bathrooms             Int                @default(0)
  poolsCount            Int                @default(0)
  hasIndoorPool         Boolean            @default(false)
  hasHeatedPool         Boolean            @default(false)
  hasFootballField      Boolean            @default(false)
  allowsFamilies        Boolean            @default(true)
  allowsYouth           Boolean            @default(false)
  allowsMixedGroups     Boolean            @default(true)
  allowsEvents          Boolean            @default(false)
  allowsOvernight       Boolean            @default(true)
  checkInTime           String?
  checkOutTime          String?
  status                PropertyStatus     @default(draft)
  verificationStatus    VerificationStatus @default(unverified)
  instantBookingEnabled Boolean            @default(true)
  hasPlatformDeal       Boolean            @default(false)
  ratingAvg             Decimal?           @db.Decimal(3, 2)
  reviewCount           Int                @default(0)
  /// Nullable so truthful incomplete drafts can omit pricing until Step 4.
  basePrice             Decimal?           @db.Decimal(10, 2)
  currency              String             @default("JOD")
  cleaningFee           Decimal?           @db.Decimal(10, 2)
  /// Optional per-property deposit % override; null = platform DEFAULT_DEPOSIT_PERCENT
  depositPercent        Decimal?           @db.Decimal(5, 2)
  /// Owner-visible active change-request reason (cleared on successful resubmit).
  reviewChangeReason       String?   @db.Text
  /// When the active change request was set (cleared with reason on resubmit).
  reviewChangeRequestedAt  DateTime?
  /// Owner-visible rejection reason when status is rejected (terminal).
  reviewRejectionReason    String?   @db.Text
  /// When the property was rejected (server-set on rejection).
  reviewRejectedAt         DateTime?
  /// Phase 3C.4D.3 — contracting operator party (nullable on legacy/draft)
  contractingOperatorPartyId String?
  /// Declared Property owner party when not same as contracting operator
  declaredPropertyOwnerPartyId String?
  declaredPropertyOwnerRelation DeclaredPropertyOwnerRelation?
  authorityBasis            PropertyAuthorityBasis?
  authorityReviewStatus     PropertyAuthorityReviewStatus @default(not_submitted)
  authorityReviewReason     String?   @db.Text
  authorityReviewedAt       DateTime?
  authorityReviewedByUserId String?
  authorityAttestedAt       DateTime?
  authorityAttestationVersion String?
  authorityAttestedByUserId String?
  /// Phase 3C.4D.5 — pool safety disclosure attestation (not regulatory verification)
  poolSafetyAttestedAt         DateTime?
  poolSafetyAttestationVersion String?
  poolSafetyAttestedByUserId   String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  owner     OwnerProfile      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contractingOperator OperatorParty? @relation("PropertyContractingOperator", fields: [contractingOperatorPartyId], references: [id], onDelete: SetNull)
  declaredPropertyOwner OperatorParty? @relation("PropertyDeclaredOwner", fields: [declaredPropertyOwnerPartyId], references: [id], onDelete: SetNull)
  media     PropertyMedia[]
  amenities PropertyAmenity[]
  rules     PropertyRule[]
  favorites         Favorite[]
  availabilitySlots AvailabilitySlot[]
  availabilityRules PropertyAvailabilityRule[]
  bookings          Booking[]
  commercialTerms   PartnerCommercialTerms[]
  reviews           Review[]
  promotions        PropertyPromotion[]
  coupons           PropertyCoupon[]
  platformCoupons   PlatformCoupon[]
  placements        PropertyPlacement[]
  sponsorshipOrders SponsoredPlacementOrder[]
  authorityReviewEvents PropertyAuthorityReviewEvent[]
  ownerAttestations     OwnerAttestation[]
  activities            PropertyActivity[]
  regulatoryRequirements PropertyRegulatoryRequirement[]
  poolSafetyProfile     PropertyPoolSafetyProfile?
  safetyDisclosures     PropertySafetyDisclosure[]

  @@index([city, status])
  @@index([status, verificationStatus])
  @@index([slug])
  @@index([authorityReviewStatus])
  @@index([contractingOperatorPartyId])
}

model PropertyMedia {
  id                 String             @id @default(cuid())
  propertyId         String
  type               MediaType          @default(image)
  url                String
  thumbnailUrl       String?
  /** Local relative path or Cloudinary public_id — null for external URL imports */
  storageKey         String?
  altAr              String?
  altEn              String?
  sortOrder          Int                @default(0)
  verificationStatus VerificationStatus @default(owner_uploaded)
  /// Phase 3C.4D.6 — soft-remove from live listing; keep row for Booking snapshot evidence
  removedFromListingAt DateTime?
  createdAt          DateTime           @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@index([propertyId, removedFromListingAt])
}

model PropertyPromotion {
  id            String                 @id @default(cuid())
  propertyId    String
  titleAr       String
  titleEn       String
  discountType  PromotionDiscountType
  discountValue Decimal                @db.Decimal(10, 2)
  startsAt      DateTime
  endsAt        DateTime
  period        AvailabilityPeriod?
  status        PromotionStatus        @default(draft)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([propertyId, status])
  @@index([status, startsAt, endsAt])
}

model PropertyCoupon {
  id                   String                 @id @default(cuid())
  propertyId           String
  normalizedCode       String
  discountType         PromotionDiscountType
  discountValue        Decimal                @db.Decimal(10, 2)
  startsAt             DateTime
  endsAt               DateTime
  minBookingAmount     Decimal?               @db.Decimal(10, 2)
  maxUses              Int?
  maxUsesPerCustomer   Int                    @default(1)
  status               PromotionStatus        @default(draft)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  redemptions CouponRedemption[]

  @@unique([propertyId, normalizedCode])
  @@index([propertyId, status])
  @@index([status, startsAt, endsAt])
}

model CouponRedemption {
  id         String                  @id @default(cuid())
  couponId   String
  bookingId  String                  @unique
  userId     String
  status     CouponRedemptionStatus  @default(reserved)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  coupon  PropertyCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, status])
  @@index([couponId, userId, status])
}

model PlatformCoupon {
  id                 String                 @id @default(cuid())
  normalizedCode     String                 @unique
  titleAr            String
  titleEn            String
  discountType       PromotionDiscountType
  discountValue      Decimal                @db.Decimal(10, 2)
  startsAt           DateTime
  endsAt             DateTime
  minBookingAmount   Decimal?               @db.Decimal(10, 2)
  maxUses            Int?
  maxUsesPerCustomer Int                    @default(1)
  propertyId         String?
  status             PromotionStatus        @default(draft)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  property    Property?                   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  bookings    Booking[]
  redemptions PlatformCouponRedemption[]

  @@index([status, startsAt, endsAt])
  @@index([propertyId, status])
}

model PlatformCouponRedemption {
  id         String                 @id @default(cuid())
  couponId   String
  bookingId  String                 @unique
  userId     String
  status     CouponRedemptionStatus @default(reserved)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  coupon  PlatformCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, status])
  @@index([couponId, userId, status])
}

model PropertyPlacement {
  id                 String          @id @default(cuid())
  propertyId         String
  placementType      PlacementType
  startsAt           DateTime
  endsAt             DateTime
  status             PromotionStatus @default(draft)
  adminNote          String?
  createdByAdminId   String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  sponsorshipOrder SponsoredPlacementOrder?

  @@index([propertyId, status])
  @@index([status, startsAt, endsAt])
  @@index([placementType, status])
}

model SponsoredPlacementPackage {
  id            String               @id @default(cuid())
  nameAr        String
  nameEn        String
  durationDays  Int
  priceAmount   Decimal              @db.Decimal(10, 2)
  currency      String               @default("JOD")
  status        CatalogPackageStatus @default(inactive)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  orders SponsoredPlacementOrder[]

  @@index([status])
}

model SponsoredPlacementOrder {
  id                       String               @id @default(cuid())
  ownerId                  String
  propertyId               String
  packageId                String?
  packageNameArSnapshot    String
  packageNameEnSnapshot    String
  durationDaysSnapshot     Int
  priceAmountSnapshot      Decimal              @db.Decimal(10, 2)
  currency                 String               @default("JOD")
  advertisingRevenueAmount Decimal?             @db.Decimal(10, 2)
  status                   SponsoredOrderStatus @default(pending_review)
  requestedAt              DateTime             @default(now())
  approvedAt               DateTime?
  paidAt                   DateTime?
  activatedAt              DateTime?
  cancelledAt              DateTime?
  rejectedAt               DateTime?
  paymentReference         String?
  paymentDate              DateTime?            @db.Date
  adminNote                String?
  placementId              String?              @unique
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  owner     OwnerProfile                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property  Property                     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  package   SponsoredPlacementPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  placement PropertyPlacement?           @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([propertyId, status])
  @@index([status])
}

model PropertyRule {
  id            String  @id @default(cuid())
  propertyId    String
  titleAr       String
  titleEn       String?
  descriptionAr String?
  descriptionEn String?
  sortOrder     Int     @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Amenity {
  id       String  @id @default(cuid())
  key      String  @unique
  labelAr  String
  labelEn  String
  icon     String?
  category String?
  isActive Boolean @default(true)

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Favorite {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

model PropertyAvailabilityRule {
  id         String             @id @default(cuid())
  propertyId String
  /// Sunday=0 … Saturday=6 in the platform time zone (Asia/Amman).
  weekday    Int
  period     AvailabilityPeriod
  enabled    Boolean            @default(true)
  /// Local civil time HH:mm in the platform time zone.
  startTime  String             @db.VarChar(5)
  endTime    String             @db.VarChar(5)
  price      Decimal            @db.Decimal(10, 2)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slots    AvailabilitySlot[]

  @@unique([propertyId, weekday, period])
  @@index([propertyId])
}

model AvailabilitySlot {
  id              String                 @id @default(cuid())
  propertyId      String
  date            DateTime               @db.Date
  period          AvailabilityPeriod
  price           Decimal                @db.Decimal(10, 2)
  status          AvailabilitySlotStatus @default(available)
  startAt         DateTime?
  endAt           DateTime?
  source          AvailabilitySlotSource @default(legacy)
  ruleId          String?
  priceOverridden Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  property Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rule     PropertyAvailabilityRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@unique([propertyId, date, period])
  @@index([propertyId, date, status])
  @@index([propertyId, startAt, endAt])
  @@index([date, status, period])
}

model Booking {
  id                 String        @id @default(cuid())
  publicCode         String        @unique
  userId             String
  propertyId         String
  availabilitySlotId String
  guestsCount        Int
  totalAmount        Decimal       @db.Decimal(10, 2)
  currency           String        @default("JOD")
  status             BookingStatus @default(pending_payment)
  /// Snapshot of the property setting at booking creation.
  instantBookingEnabled Boolean @default(true)
  ownerDecisionAt       DateTime?
  ownerDecisionReason   String?
  ownerApprovalExpiresAt DateTime?
  ownerDecisionOutcome  OwnerDecisionOutcome?
  paymentCollectionMode PaymentCollectionMode @default(deposit_balance)
  paymentState          BookingPaymentState   @default(unpaid)
  depositPercent            Decimal  @db.Decimal(5, 2)
  depositAmount             Decimal  @db.Decimal(10, 2)
  remainingAmount           Decimal  @db.Decimal(10, 2)
  platformCommissionPercent Decimal  @db.Decimal(5, 2)
  platformCommissionAmount  Decimal  @db.Decimal(10, 2)
  ownerNetPayoutAmount      Decimal  @db.Decimal(10, 2)
  customerServiceFeeAmount  Decimal  @default(0) @db.Decimal(10, 2)
  customerPayableTotal      Decimal  @db.Decimal(10, 2)
  originalSlotPrice         Decimal  @db.Decimal(10, 2)
  promotionDiscountAmount   Decimal  @default(0) @db.Decimal(10, 2)
  promotionId               String?
  couponId                  String?
  couponCodeSnapshot        String?
  couponDiscountAmount      Decimal  @default(0) @db.Decimal(10, 2)
  priceBeforeCoupon         Decimal? @db.Decimal(10, 2)
  platformCouponId          String?
  platformCouponCodeSnapshot String?
  platformDiscountAmount    Decimal  @default(0) @db.Decimal(10, 2)
  merchantBookingValue      Decimal? @db.Decimal(10, 2)
  commissionBasisAmount     Decimal? @db.Decimal(10, 2)
  balanceDueAt   DateTime?
  holdExpiresAt  DateTime?
  depositPaidAt  DateTime?
  fullyPaidAt    DateTime?
  /// Snapshot of the booked interval (UTC). Null on legacy untimed slots.
  bookingStartAt DateTime?
  bookingEndAt   DateTime?
  /// True when the booking used the documented UTC-date fallback (no real startAt).
  usesLegacyTiming Boolean @default(true)
  commercialTermsId     String?
  commissionSource      CommissionSource?
  ownerPayoutDelayHours Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?
  /// Phase 1 — machine-readable cancel reason (e.g. BALANCE_NOT_PAID, CUSTOMER_CANCEL).
  cancellationReasonCode String?
  /// Phase 2 — original start before customer reschedule (anti-abuse anchor).
  originalBookingStartAt DateTime?
  latestRescheduledAt    DateTime?
  rescheduleCount        Int            @default(0)
  checkInStatus          CheckInStatus  @default(not_open)
  checkInCodeHash        String?
  checkInCodeSalt        String?
  checkInVerifiedAt      DateTime?
  checkInExpiresAt       DateTime?
  /// Phase 3C.4E.4B — terminal visit outcome (null = legacy / not yet resolved).
  visitOutcome           BookingVisitOutcome?
  visitOutcomeAt         DateTime?
  visitOutcomeSource     String?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: historical Bookings must retain Property identity; snapshot remains even if listing archived.
  property Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  slot     AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  promotion PropertyPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  coupon    PropertyCoupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  platformCoupon PlatformCoupon? @relation(fields: [platformCouponId], references: [id], onDelete: SetNull)
  commercialTerms PartnerCommercialTerms? @relation(fields: [commercialTermsId], references: [id], onDelete: SetNull)
  payments       Payment[]
  refundRequests RefundRequest[]
  disputes       Dispute[]
  supportTickets SupportTicket[]
  review         Review?
  couponRedemption CouponRedemption?
  platformCouponRedemption PlatformCouponRedemption?
  incidents          BookingIncident[]
  rescheduleRequests BookingRescheduleRequest[]
  goodwillCredits    Mazare3GoodwillCredit[]
  ownerAdjustments   OwnerFinancialAdjustment[]
  legalSnapshot      BookingLegalSnapshot?
  legalAcceptances   LegalAcceptance[]
  /// Phase 3C.4D.6 — immutable Booking-time listing snapshot(s)
  propertySnapshots  BookingPropertySnapshot[]

  @@index([userId, status])
  @@index([propertyId])
  @@index([publicCode])
  @@index([availabilitySlotId, status])
  @@index([paymentState])
  @@index([holdExpiresAt])
  @@index([ownerApprovalExpiresAt])
  @@index([balanceDueAt])
  @@index([promotionId])
  @@index([couponId])
  @@index([platformCouponId])
  @@index([visitOutcome, status])
  // Phase 3C.4E.3 — PostgreSQL partial unique index (SQL migration, not Prisma @@unique):
  // Booking_one_holding_per_availability_slot ON (availabilitySlotId)
  // WHERE status IN (pending_owner_approval, pending_payment, pending, confirmed)
}

model Review {
  id             String       @id @default(cuid())
  bookingId      String       @unique
  propertyId     String
  customerId     String
  rating         Int
  comment        String?      @db.Text
  status         ReviewStatus @default(published)
  hiddenReason   String?      @db.Text
  hiddenAt       DateTime?
  hiddenByUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([customerId])
}

model Payment {
  id             String          @id @default(cuid())
  bookingId      String
  userId         String
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("JOD")
  method         PaymentMethod
  purpose        PaymentPurpose  @default(full)
  provider       PaymentProvider @default(test)
  status         PaymentStatus   @default(initiated)
  bookingTotalAmount         Decimal       @db.Decimal(10, 2)
  customerPayableAmount      Decimal       @db.Decimal(10, 2)
  platformCommissionAmount   Decimal       @default(0) @db.Decimal(10, 2)
  customerServiceFeeAmount   Decimal       @default(0) @db.Decimal(10, 2)
  ownerGrossAmount           Decimal       @default(0) @db.Decimal(10, 2)
  ownerNetPayoutAmount       Decimal       @default(0) @db.Decimal(10, 2)
  payoutStatus               PayoutStatus  @default(not_ready)
  payoutAvailableAt          DateTime?
  cancellationRefundAmount   Decimal?      @db.Decimal(10, 2)
  cancellationPenaltyAmount  Decimal?      @db.Decimal(10, 2)
  refundStatus               RefundStatus  @default(none)
  /// Phase 3A — links delta payment to an accepted_pending_payment reschedule.
  rescheduleRequestId String?
  idempotencyKey String?         @unique
  providerRef    String?
  expiresAt      DateTime?
  succeededAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         PaymentEvent[]
  refundRequests RefundRequest[]
  refundAllocations RefundPaymentAllocation[]
  payoutRecord   OwnerPayout?

  @@index([bookingId, status])
  @@index([bookingId, purpose, status])
  @@index([userId])
  @@index([status])
  @@index([rescheduleRequestId])
}

model PaymentEvent {
  id        String         @id @default(cuid())
  paymentId String
  action    String
  status    PaymentStatus?
  metadata  Json?
  createdAt DateTime       @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

/**
 * CB-5A — persistent PayTabs saved-card vault (token only; never PAN/CVV).
 * Charging with these tokens is deferred to CB-5B.
 */
model SavedPaymentMethod {
  id                            String          @id @default(cuid())
  userId                        String
  provider                      PaymentProvider
  /** AES-GCM ciphertext of PayTabs persistent card token (pv1.…). Never return to browser. */
  providerTokenCipher           String
  /** HMAC fingerprint of plaintext token for uniqueness / dedupe. */
  providerTokenFingerprint      String
  providerOriginalTransactionRef String?
  brand                         String?
  /** Safe display e.g. Visa •••• 4242 — only when provider metadata allows. */
  maskedDisplay                 String?
  last4                         String?
  expiryMonth                   Int?
  expiryYear                    Int?
  isDefault                     Boolean         @default(false)
  revokedAt                     DateTime?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerTokenFingerprint])
  @@index([userId, revokedAt])
  @@index([userId, isDefault])
}

model RefundRequest {
  id                 String              @id @default(cuid())
  bookingId          String
  /// Anchor payment (newest eligible capture at creation). Execution uses RefundPaymentAllocation rows.
  paymentId          String
  customerId         String
  reason             String              @db.Text
  policyRefundAmount Decimal             @db.Decimal(10, 2)
  requestedAmount    Decimal             @db.Decimal(10, 2)
  approvedAmount     Decimal?            @db.Decimal(10, 2)
  /// Phase 3C.4E.2A — sum of succeeded allocation refunds (fils-safe Decimal).
  refundedAmount     Decimal             @default(0) @db.Decimal(10, 2)
  status             RefundRequestStatus @default(pending)
  adminNote          String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  booking     Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment     Payment                   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customer    User                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  allocations RefundPaymentAllocation[]

  @@index([bookingId, status])
  @@index([customerId, status])
  @@index([paymentId])
}

/// Phase 3C.4E.2A — allocates a Booking-level RefundRequest across one or more captured Payments.
model RefundPaymentAllocation {
  id                 String                 @id @default(cuid())
  refundRequestId    String
  paymentId          String
  allocatedAmount    Decimal                @db.Decimal(10, 2)
  refundedAmount     Decimal                @default(0) @db.Decimal(10, 2)
  status             RefundAllocationStatus @default(pending)
  /// Provider refund tran_ref when known.
  providerRefundRef  String?
  idempotencyKey     String                 @unique
  attemptCount       Int                    @default(0)
  lastError          String?                @db.Text
  lastAttemptAt      DateTime?
  succeededAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([refundRequestId, paymentId])
  @@index([paymentId, status])
  @@index([refundRequestId, status])
}

model Dispute {
  id              String        @id @default(cuid())
  bookingId       String
  openedByUserId  String
  type            DisputeType
  status          DisputeStatus @default(open)
  description     String        @db.Text
  adminNote       String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy User    @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@index([openedByUserId])
}

/// Customer support / contact messages. Communication only — never mutates booking, payment, refund, or payout state.
model SupportTicket {
  id               String                 @id @default(cuid())
  publicCode       String                 @unique
  source           SupportTicketSource
  status           SupportTicketStatus    @default(open)
  category         SupportTicketCategory
  subject          String
  message          String                 @db.Text
  userId           String?
  guestName        String?
  guestEmail       String?
  bookingId        String?
  adminResponse    String?                @db.Text
  adminRespondedAt DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, source])
  @@index([bookingId])
  @@index([guestEmail])
  @@index([publicCode])
}

model OwnerPayout {
  id              String                  @id @default(cuid())
  ownerId         String
  paymentId       String                  @unique
  bookingId       String
  amount          Decimal                 @db.Decimal(10, 2)
  currency        String                  @default("JOD")
  status          OwnerPayoutRecordStatus @default(eligible)
  periodFrom      DateTime                @db.Date
  periodTo        DateTime                @db.Date
  paidAt          DateTime?
  adminNote       String?                 @db.Text
  manualReference String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  owner   OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  settlementItems OwnerSettlementItem[]

  @@index([ownerId, status])
  @@index([bookingId])
}

model OwnerSettlement {
  id                      String                @id @default(cuid())
  ownerId                 String
  periodStart             DateTime              @db.Date
  periodEnd               DateTime              @db.Date
  status                  OwnerSettlementStatus @default(draft)
  itemCount               Int                   @default(0)
  grossBookingAmount      Decimal               @db.Decimal(10, 2)
  platformCommissionTotal Decimal               @db.Decimal(10, 2)
  refundAdjustmentTotal   Decimal               @default(0) @db.Decimal(10, 2)
  ownerNetAmount          Decimal               @db.Decimal(10, 2)
  currency                String                @default("JOD")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  finalizedAt             DateTime?
  paidAt                  DateTime?
  paymentReference        String?
  adminNote               String?               @db.Text

  owner OwnerProfile          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items OwnerSettlementItem[]
  financialAdjustments OwnerFinancialAdjustment[]

  @@index([ownerId, status])
  @@index([status])
}

model OwnerSettlementItem {
  id                       String    @id @default(cuid())
  settlementId             String
  payoutId                 String
  paymentId                String
  bookingId                String
  publicCode               String
  bookingDate              DateTime  @db.Date
  bookingTotalAmount       Decimal   @db.Decimal(10, 2)
  platformCommissionAmount Decimal   @db.Decimal(10, 2)
  ownerNetPayoutAmount     Decimal   @db.Decimal(10, 2)
  payoutAmount             Decimal   @db.Decimal(10, 2)
  refundAdjustmentAmount   Decimal   @default(0) @db.Decimal(10, 2)
  releasedAt               DateTime?

  settlement OwnerSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  payout     OwnerPayout     @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@index([payoutId])
  @@index([paymentId])
  @@index([bookingId])
}

model OwnerVerificationProfile {
  id                           String                     @id @default(cuid())
  ownerProfileId               String                     @unique
  entityType                   PartnerEntityType?
  /// Phase 3C.4D.3 — how account holder relates to contracting operator
  accountHolderRelation        AccountHolderOperatorRelation?
  verificationStatus           PartnerVerificationStatus  @default(draft)
  legalName                    String?
  operatingPhone               String?
  operatingCity                String?
  operatingArea                String?
  contactEmail                 String?
  changeRequestReason          String?                    @db.Text
  changeRequestAt              DateTime?
  rejectionReason              String?                    @db.Text
  rejectedAt                   DateTime?
  rejectedByUserId             String?
  suspensionReason             String?                    @db.Text
  suspendedAt                  DateTime?
  suspendedByUserId            String?
  previousVerificationStatus   PartnerVerificationStatus?
  approvedAt                   DateTime?
  approvedByUserId             String?
  submittedAt                  DateTime?
  reviewedAt                   DateTime?
  restoredAt                   DateTime?
  usePlatformDefaultCommission Boolean                    @default(false)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt

  owner OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@index([entityType])
}

model PartnerDocumentRequirement {
  id            String              @id @default(cuid())
  documentType  PartnerDocumentType
  entityType    PartnerEntityType?
  required      Boolean             @default(true)
  active        Boolean             @default(true)
  labelAr       String
  labelEn       String
  descriptionAr String              @db.Text
  descriptionEn String              @db.Text
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([active, documentType])
}

model OwnerDocument {
  id               String                    @id @default(cuid())
  ownerProfileId   String
  /// Phase 3C.4D.3 — optional Property scope for authority evidence (null = owner-level KYC)
  propertyId       String?
  requirementId    String?
  documentType     PartnerDocumentType
  originalFileName String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  reviewStatus     OwnerDocumentReviewStatus @default(uploaded)
  rejectionReason  String?                   @db.Text
  reviewedByUserId String?
  reviewedAt       DateTime?
  uploadedAt       DateTime                  @default(now())
  supersededById   String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  owner OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)

  @@index([ownerProfileId, documentType])
  @@index([propertyId, documentType])
  @@index([reviewStatus])
}

/// Phase 3C.4D.3 — contracting / declared owner party (account holder is User, not this row)
model OperatorParty {
  id                     String             @id @default(cuid())
  ownerProfileId         String
  entityKind             OperatorEntityKind
  legalName              String
  registrationNumber     String?
  registrationAuthority  String?
  country                String             @default("JO")
  contactEmail           String?
  contactPhone           String?
  /// Default contracting operator for this OwnerProfile (at most one intended)
  isDefaultContractingOperator Boolean      @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  owner OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  contractingForProperties Property[] @relation("PropertyContractingOperator")
  declaredOwnerForProperties Property[] @relation("PropertyDeclaredOwner")
  payoutProfilesAsContractingOperator OwnerPayoutProfile[]

  @@index([ownerProfileId])
  @@index([ownerProfileId, isDefaultContractingOperator])
}

/// Recorded Owner attestation (not a substitute for evidence review)
model OwnerAttestation {
  id                      String   @id @default(cuid())
  userId                  String
  ownerProfileId          String
  propertyId              String?
  attestationKey          String
  attestationCorpusVersion String
  sourceSurface           String?
  acceptedAt              DateTime @default(now())
  createdAt               DateTime @default(now())

  owner    OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  property Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([ownerProfileId, attestationKey])
  @@index([propertyId, attestationKey])
  @@index([userId])
}

/// Append-only authority review decisions
model PropertyAuthorityReviewEvent {
  id                   String                       @id @default(cuid())
  propertyId           String
  previousStatus       PropertyAuthorityReviewStatus
  newStatus            PropertyAuthorityReviewStatus
  actorUserId          String
  reasonCategory       String?
  reasonText           String?                      @db.Text
  evidenceDocumentIds  Json?
  createdAt            DateTime                     @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([actorUserId])
}

/// Phase 3C.4D.4A — multi-select activity profile (not a licence decision)
model PropertyActivity {
  id              String              @id @default(cuid())
  propertyId      String
  activityCode    PropertyActivityCode
  /// Short free-text only when activityCode = other
  otherDescription String?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, activityCode])
  @@index([propertyId, active])
  @@index([activityCode])
}

/// Property-scoped regulatory requirement instance
model PropertyRegulatoryRequirement {
  id                 String                     @id @default(cuid())
  propertyId         String
  requirementType    RegulatoryRequirementType
  applicability      RegulatoryApplicability    @default(unassessed)
  complianceStatus   RegulatoryComplianceStatus @default(not_assessed)
  issuingAuthority   String?
  referenceNumber    String?
  issueDate          DateTime?
  validFrom          DateTime?
  expiresAt          DateTime?
  reviewReason       String?                    @db.Text
  reviewedByUserId   String?
  reviewedAt         DateTime?
  verifiedAt         DateTime?
  /// Soft flag when activity/operator/location change requires re-check
  reassessmentRequired Boolean                  @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  evidence RegulatoryEvidence[]
  decisionEvents RegulatoryDecisionEvent[]

  @@unique([propertyId, requirementType])
  @@index([propertyId, applicability, complianceStatus])
  @@index([requirementType])
  @@index([expiresAt])
}

/// Private regulatory evidence — storageKey only (reuse partner private storage)
model RegulatoryEvidence {
  id               String   @id @default(cuid())
  requirementId    String
  uploadedByUserId String
  originalFileName String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  label            String?
  documentNumber   String?
  issuerName       String?
  issueDate        DateTime?
  expiresAt        DateTime?
  superseded       Boolean  @default(false)
  supersededById   String?
  uploadedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requirement PropertyRegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId, superseded])
  @@index([expiresAt])
}

/// Append-only regulatory applicability/status decisions
model RegulatoryDecisionEvent {
  id                     String                      @id @default(cuid())
  requirementId          String
  propertyId             String
  previousApplicability  RegulatoryApplicability
  newApplicability       RegulatoryApplicability
  previousComplianceStatus RegulatoryComplianceStatus
  newComplianceStatus    RegulatoryComplianceStatus
  actorUserId            String
  reasonCategory         String?
  reasonText             String?                     @db.Text
  evidenceIds            Json?
  createdAt              DateTime                    @default(now())

  requirement PropertyRegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId, createdAt])
  @@index([propertyId, createdAt])
  @@index([actorUserId])
}

/// Phase 3C.4D.5 — Owner-reported pool / water-feature safety profile (not government certification)
model PropertyPoolSafetyProfile {
  id                              String               @id @default(cuid())
  propertyId                      String               @unique
  waterFeatureKind                PoolWaterFeatureKind @default(swimming_pool)
  /// Indoor / outdoor — optional; may both be true for multi-pool sites
  isIndoor                        Boolean?
  isOutdoor                       Boolean?
  /// Owner-provided approximate depths in metres (not certified measurements)
  minDepthMeters                  Decimal?             @db.Decimal(4, 2)
  maxDepthMeters                  Decimal?             @db.Decimal(4, 2)
  childrenAllowed                 Boolean?
  childrenRequireAdultSupervision Boolean?
  seasonality                     PoolSeasonality      @default(unknown)
  accessRestrictionsAr            String?              @db.Text
  accessRestrictionsEn            String?              @db.Text
  otherWarningsAr                 String?              @db.Text
  otherWarningsEn                 String?              @db.Text
  /// True when minimum profile fields for swimming_pool submission are complete
  profileComplete                 Boolean              @default(false)
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/// Phase 3C.4D.5 — optional material Property safety/access disclosures (Owner facts)
model PropertySafetyDisclosure {
  id             String                           @id @default(cuid())
  propertyId     String
  category       PropertySafetyDisclosureCategory
  descriptionAr  String                           @db.Text
  descriptionEn  String?                          @db.Text
  active         Boolean                          @default(true)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, active])
  @@index([category])
}

model OwnerPayoutProfile {
  id                    String                  @id @default(cuid())
  ownerProfileId        String                  @unique
  beneficiaryNameCipher String                  @db.Text
  bankNameCipher        String                  @db.Text
  ibanCipher            String                  @db.Text
  ibanLast4             String
  ibanFingerprint       String
  optionalNotesCipher   String?                 @db.Text
  /// Contracting OperatorParty referenced at last material save (not User display name)
  contractingOperatorPartyId String?
  beneficiaryRelationship    PayoutBeneficiaryRelationship?
  /// ISO country for payout rail context (default JO) — not ownership proof
  payoutCountry              String?            @db.VarChar(2)
  /// Heuristic only — Admin remains authoritative for approval
  nameMatchHint              PayoutBeneficiaryNameMatchHint?
  reviewStatus          OwnerPayoutReviewStatus @default(pending)
  reviewReason          String?                 @db.Text
  /// Controlled category for Owner-visible action-required / reject reasons
  reviewReasonCategory  String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  owner                 OwnerProfile   @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  contractingOperator   OperatorParty? @relation(fields: [contractingOperatorPartyId], references: [id], onDelete: SetNull)
  reviewEvents          OwnerPayoutBeneficiaryReviewEvent[]

  @@index([reviewStatus])
  @@index([contractingOperatorPartyId])
}

/// Append-only payout-beneficiary review / material-change audit (no full IBAN)
model OwnerPayoutBeneficiaryReviewEvent {
  id               String   @id @default(cuid())
  payoutProfileId  String
  ownerProfileId   String
  actorUserId      String?
  previousStatus   String?
  newStatus        String
  reasonCategory   String?
  reason           String?  @db.Text
  ibanLast4        String?
  beneficiaryRelationship String?
  nameMatchHint    String?
  metadata         Json?
  createdAt        DateTime @default(now())

  payoutProfile OwnerPayoutProfile @relation(fields: [payoutProfileId], references: [id], onDelete: Cascade)

  @@index([payoutProfileId, createdAt])
  @@index([ownerProfileId, createdAt])
}

model PartnerAgreement {
