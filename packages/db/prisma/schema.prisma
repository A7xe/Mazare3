// Mazare3 Jordan — Phase 2 foundation
// Booking/payment models come in later phases.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  owner
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum OwnerStatus {
  pending
  approved
  rejected
  suspended
}

enum PropertyStatus {
  draft
  pending_review
  changes_requested
  approved
  published
  unpublished
  suspended
  rejected
}

enum VerificationStatus {
  unverified
  owner_uploaded
  platform_reviewed
  platform_verified
}

enum PropertyType {
  farm
  chalet
  villa
  istiraha
  private_resort
  pool_house
}

enum MediaType {
  image
  video
  virtual_tour
}

enum AvailabilityPeriod {
  morning
  evening
  full_day
  overnight
}

enum AvailabilitySlotStatus {
  available
  blocked
  booked
}

enum BookingStatus {
  pending
  pending_payment
  confirmed
  cancelled
  expired
}

enum PaymentStatus {
  initiated
  pending
  succeeded
  failed
  cancelled
  expired
  refunded
}

enum PaymentMethod {
  card
  cliq
  manual_test
}

enum PaymentProvider {
  test
  cliq
  card_gateway
}

enum PayoutStatus {
  not_ready
  pending
  eligible
  paid
  blocked
}

enum RefundStatus {
  none
  pending
  approved
  rejected
  processed
}

enum RefundRequestStatus {
  pending
  approved
  rejected
  processed
  cancelled
}

enum DisputeType {
  property_mismatch
  owner_cancelled
  access_problem
  cleanliness_issue
  other
}

enum DisputeStatus {
  open
  under_review
  resolved
  rejected
}

enum OwnerPayoutRecordStatus {
  pending
  eligible
  paid
  blocked
  cancelled
}

model User {
  id               String     @id @default(cuid())
  name             String?
  email            String     @unique
  phone            String?
  passwordHash     String?
  externalAuthId   String?
  externalProvider String?
  role             UserRole   @default(customer)
  status           UserStatus @default(active)
  locale           String     @default("ar")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  ownerProfile OwnerProfile?
  favorites    Favorite[]
  bookings       Booking[]
  payments       Payment[]
  refundRequests RefundRequest[]
  disputesOpened Dispute[]       @relation("DisputeOpenedBy")
  auditLogs      AuditLog[]      @relation("AuditActor")

  @@index([role])
  @@index([status])
}

model OwnerProfile {
  id                   String      @id @default(cuid())
  userId               String      @unique
  displayName          String
  businessName         String?
  phone                String // never exposed on public listing UI
  city                 String?
  area                 String?
  bio                  String?     @db.Text
  approximateFarmCount Int?
  termsAcceptedAt      DateTime?
  status               OwnerStatus @default(pending)
  rejectionReason      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
  payouts    OwnerPayout[]
}

model Property {
  id                    String             @id @default(cuid())
  ownerId               String
  slug                  String             @unique
  type                  PropertyType
  titleAr               String
  titleEn               String?
  descriptionAr         String             @db.Text
  descriptionEn         String?            @db.Text
  city                  String
  area                  String
  approximateAddress    String
  exactAddress          String? // hidden from public API/UI until booking confirmed
  latitudeApprox        Float?
  longitudeApprox       Float?
  latitudeExact         Float?
  longitudeExact        Float?
  capacity              Int
  bedrooms              Int                @default(0)
  bathrooms             Int                @default(0)
  poolsCount            Int                @default(0)
  hasIndoorPool         Boolean            @default(false)
  hasHeatedPool         Boolean            @default(false)
  hasFootballField      Boolean            @default(false)
  allowsFamilies        Boolean            @default(true)
  allowsYouth           Boolean            @default(false)
  allowsMixedGroups     Boolean            @default(true)
  allowsEvents          Boolean            @default(false)
  allowsOvernight       Boolean            @default(true)
  checkInTime           String?
  checkOutTime          String?
  status                PropertyStatus     @default(draft)
  verificationStatus    VerificationStatus @default(unverified)
  instantBookingEnabled Boolean            @default(false)
  hasPlatformDeal       Boolean            @default(false)
  ratingAvg             Decimal?           @db.Decimal(3, 2)
  reviewCount           Int                @default(0)
  basePrice             Decimal            @db.Decimal(10, 2)
  currency              String             @default("JOD")
  cleaningFee           Decimal?           @db.Decimal(10, 2)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  owner     OwnerProfile      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  media     PropertyMedia[]
  amenities PropertyAmenity[]
  rules     PropertyRule[]
  favorites         Favorite[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]

  @@index([city, status])
  @@index([status, verificationStatus])
  @@index([slug])
}

model PropertyMedia {
  id                 String             @id @default(cuid())
  propertyId         String
  type               MediaType          @default(image)
  url                String
  thumbnailUrl       String?
  altAr              String?
  altEn              String?
  sortOrder          Int                @default(0)
  verificationStatus VerificationStatus @default(owner_uploaded)
  createdAt          DateTime           @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model PropertyRule {
  id            String  @id @default(cuid())
  propertyId    String
  titleAr       String
  titleEn       String?
  descriptionAr String?
  descriptionEn String?
  sortOrder     Int     @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Amenity {
  id       String  @id @default(cuid())
  key      String  @unique
  labelAr  String
  labelEn  String
  icon     String?
  category String?
  isActive Boolean @default(true)

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Favorite {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

model AvailabilitySlot {
  id         String                 @id @default(cuid())
  propertyId String
  date       DateTime               @db.Date
  period     AvailabilityPeriod
  price      Decimal                @db.Decimal(10, 2)
  status     AvailabilitySlotStatus @default(available)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([propertyId, date, period])
  @@index([propertyId, date, status])
}

model Booking {
  id                 String        @id @default(cuid())
  publicCode         String        @unique
  userId             String
  propertyId         String
  availabilitySlotId String
  guestsCount        Int
  totalAmount        Decimal       @db.Decimal(10, 2)
  currency           String        @default("JOD")
  status             BookingStatus @default(pending_payment)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slot     AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  payments       Payment[]
  refundRequests RefundRequest[]
  disputes       Dispute[]

  @@index([userId, status])
  @@index([propertyId])
  @@index([publicCode])
  @@index([availabilitySlotId, status])
}

model Payment {
  id             String          @id @default(cuid())
  bookingId      String
  userId         String
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("JOD")
  method         PaymentMethod
  provider       PaymentProvider @default(test)
  status         PaymentStatus   @default(initiated)
  bookingTotalAmount         Decimal       @db.Decimal(10, 2)
  customerPayableAmount      Decimal       @db.Decimal(10, 2)
  platformCommissionAmount   Decimal       @default(0) @db.Decimal(10, 2)
  customerServiceFeeAmount   Decimal       @default(0) @db.Decimal(10, 2)
  ownerGrossAmount           Decimal       @default(0) @db.Decimal(10, 2)
  ownerNetPayoutAmount       Decimal       @default(0) @db.Decimal(10, 2)
  payoutStatus               PayoutStatus  @default(not_ready)
  payoutAvailableAt          DateTime?
  cancellationRefundAmount   Decimal?      @db.Decimal(10, 2)
  cancellationPenaltyAmount  Decimal?      @db.Decimal(10, 2)
  refundStatus               RefundStatus  @default(none)
  idempotencyKey String?         @unique
  providerRef    String?
  expiresAt      DateTime?
  succeededAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         PaymentEvent[]
  refundRequests RefundRequest[]
  payoutRecord   OwnerPayout?

  @@index([bookingId, status])
  @@index([userId])
  @@index([status])
}

model PaymentEvent {
  id        String         @id @default(cuid())
  paymentId String
  action    String
  status    PaymentStatus?
  metadata  Json?
  createdAt DateTime       @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model RefundRequest {
  id                 String              @id @default(cuid())
  bookingId          String
  paymentId          String
  customerId         String
  reason             String              @db.Text
  policyRefundAmount Decimal             @db.Decimal(10, 2)
  requestedAmount    Decimal             @db.Decimal(10, 2)
  approvedAmount     Decimal?            @db.Decimal(10, 2)
  status             RefundRequestStatus @default(pending)
  adminNote          String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@index([customerId, status])
  @@index([paymentId])
}

model Dispute {
  id              String        @id @default(cuid())
  bookingId       String
  openedByUserId  String
  type            DisputeType
  status          DisputeStatus @default(open)
  description     String        @db.Text
  adminNote       String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy User    @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@index([openedByUserId])
}

model OwnerPayout {
  id              String                  @id @default(cuid())
  ownerId         String
  paymentId       String                  @unique
  bookingId       String
  amount          Decimal                 @db.Decimal(10, 2)
  currency        String                  @default("JOD")
  status          OwnerPayoutRecordStatus @default(eligible)
  periodFrom      DateTime                @db.Date
  periodTo        DateTime                @db.Date
  paidAt          DateTime?
  adminNote       String?                 @db.Text
  manualReference String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  owner   OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([bookingId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorUserId])
  @@index([createdAt])
}
